.apply(function() {
    .SkillCommand("camp").run = function() {
	if (ch.isAffected(skill.name)) {
	    ch.act(._("Ты пока не можешь разбить лагерь, подожди немного."));
	    return;
	}
	var room; room = ch.in_room;
	if (!room.isNature()) {
	    ch.act(._("Разбить полевой лагерь можно только на лоне природы."));
	    return;        
	}
	if (room.isAffected(skill.name)) {
	    ch.act(._("Здесь уже разбит полевой лагерь."));
	    return;
	}	
    
	if (!.chance(skill.effective(ch))) {
	    ch.act(._("Ты пытаешься разбить лагерь, но у тебя ничего не получается."));
	    skill.improve(ch, false);
	    return;        
	}
	
	skill.improve(ch, true);
	skill.apply(ch);
    };


    .SkillCommand("camp").apply = function() {
	var room; room = ch.in_room;	    
	
	var level; level = skill.level(ch);
	var af; af = .Affect();
	af.type             = skill.name;
	af.level            = level;
	af.duration         = .sqrt(level) + 1;
	ch.affectAdd(af); // Вешаем аффект-кулдаун на игрока
	af.location         = .tables.apply_flags.mana_gain;
	af.modifier         = level * 4;
	af.source    = ch;
	room.affectAdd(af);
	af.location         = .tables.apply_flags.heal_gain;
	af.modifier         = level * 4;
	room.affectAdd(af);	// Вешаем аффект на комнату

	ch.act(._("Ты сноровисто разбиваешь полевой лагерь."));
	ch.recho(._("%1$^C1 сноровисто разбива%1$nет|ют полевой лагерь."), ch);

	// A forest floor sometimes yields hardwood worth keeping (Kit, 2026-10-14):
	// hard sticks otherwise come only from salvage and hardwood logs.
	if (!ch.is_npc() && room.sector_type == .tables.sector_table.forest && .tmp.chance(25, ch)) {
	    var hard; hard = .get_obj_index(28045).create().obj_to_char(ch);
	    ch.act(._("Среди хвороста тебе попада%1$nется|ются %1$O1 -- ты убираешь %1$P4 в мешок."), hard);
	}
	
	if (room.get_obj_vnum(39001) != null) {
	    ch.act(._("Ты собирал{Smся{Sfась{x было разжечь костер, но кто-то его уже развел до тебя!")); 
	    return;
	}
	
	var wood; wood = .get_obj_index(28036).create().obj_to_room(room);
	ch.act(._("Ты находишь %1$O4 для растопки костра."), wood);
	ch.recho(._("%1$^C1 наход%1$nит|ят %2$O4 для растопки костра."), ch, wood); 
	.tmp.object.applyHeat(wood, ch, null, -1, true); // guaranteed ignition
    };

})

