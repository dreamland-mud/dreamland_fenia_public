.Spell("armor").runVict = function() {
    var msg;
    if (vict.isAffected(skill.name)) {
	if (ch == vict) msg = ch.print(._("Ты уже под воздействием заклинания брони."));
	else msg = ch.print(._("%1$^C1 уже под воздействием заклинания брони."), vict);
    }
    
    if (msg != null) {
	ch.act(msg);
	ch.echoMaster(msg);	
	return;
    }
    
    if (ch.profession.flags(ch) & .tables.prof_flags.divine) {
	var relmm5; relmm5 = .tmp.religion.relNameMM(rel, 5);
	vict.act(._("Тебя окружает священная броня, дарованная {1{C%s{2."), relmm5);
	vict.recho(._("%^C4 окружает священная броня, дарованная {1{C%s{2."), vict, relmm5);
    } // Если молитва, пишем, от какого божества
    else {
	vict.act(._("Тебя окружает магическая броня, улучшающая защитные навыки."));
	vict.recho(._("%^C4 окружает магическая броня, улучшающая защитные навыки."), vict);
    }

    var af; af = .Affect();
    af.type      = skill.name;
    af.level     = level;
    af.duration  = 7 + level / 6;
    af.location  = .tables.apply_flags.ac;
    af.modifier  = -1 * level / 3;
    vict.affectAdd(af);
    af.location = .tables.apply_flags.learned;
    af.where = .tables.affwhere_flags.skill_groups;
    af.global = "defensive"; // множественные значения можно задать через пробел 
    af.modifier  = level/25;
    vict.affectAdd(af);	
}