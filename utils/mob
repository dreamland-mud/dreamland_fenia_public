// Various helpers to determine character features or parameters
.apply(function() {
    if (.tmp.mob == null) .tmp.mob = .Map();
    
    /////////////////////////////////////////////////////////////
    ////////////////////// BASIC HELPERS ////////////////////////
    /////////////////////////////////////////////////////////////
    
    // Basic helper to see if ch "exists"
    .tmp.mob.valid = function(ch) {
	// No other checks needed: ch.dead returns true for offline players/mobs
	return (ch != null && !ch.dead);
    };

    // Is ch awake and capable of perceiving reality?
    .tmp.mob.awake = function(ch) {
	return (.tmp.mob.valid(ch) &&
		ch.position >= .tables.position_table.rest);
    };
    
    // Is ch awake and can perform auto-actions, 
    // e.g. defensive skills (anything that doesn't require explicit command)
    .tmp.mob.canMove = function(ch) {
	return (.tmp.mob.awake(ch) &&
		!(ch.affected_by & .tables.affect_flags.stun));
    };
    
    // Can a character can perform explicit actions
    .tmp.mob.isActive = function(ch) {
	return (.tmp.mob.canMove(ch) &&
		!(ch.detection & .tables.detect_flags.fear) &&
		ch.wait <= 0);
    };

    // NPC can perform ambient actions (e.g. randomly emote)
    .tmp.mob.canActAmbient = function(mob) {	
	return (.tmp.mob.isActive(mob) && mob.is_npc() && 
		mob.fighting == null);
    };
    
    // TO-DO (RUFFINA): replace this with native support for boat_get_types
    // P.S. And better yet improve the utter hell with "boat types"
    .tmp.mob.boatType = function(ch) {
	var boat; boat = "";
	// Available boat types are added as complementary bits, but in reality
	// char only uses ONE "boat type" at a time. Let's assume this:
	// (1) fly --> (2) swim --> (3) boat
	if (.tmp.mob.valid(ch)) {
	    if (ch.flying)
		boat = "fly";
	    else if (ch.affected_by & .tables.affect_flags.swim)
		boat = "swim";
	    else if (ch.boat != null)
		boat = "boat";
	}
	return boat;
    };

    // Basic helper to determine mob's "weight" (based on C++ make_corpse)
    // Calculate in 1/10 of a pound (to match C++), then convert to pounds
    .tmp.mob.weight = function(ch) {		
	var weight;

	// Tiny: 1-6 kg <-- 2-12 pounds -- insects/small rodents
	if (ch.size == 0) {
	    if (ch.form &.tables.form_flags.insect
		|| ch.form &.tables.form_flags.spider
		|| ch.form &.tables.form_flags.worm)
		weight = .number_range(1, 10);
	    else weight = .number_range(20, 120);
	}
	// Small: 7-40 kg <-- 14-80 pounds -- rodents/birds/kenders/faeries
	else if (ch.size == 1) {
	    if (ch.form &.tables.form_flags.bird
		|| ch.form &.tables.form_flags.snake
		|| ch.form &.tables.form_flags.fish)
		weight = .number_range(20, 100);
	    else weight = .number_range(140, 800);
	}
	// Medium: 40-110 kg <-- 80-220 pounds -- most humanoids and PC races
	else if (ch.size == 2) weight = .number_range(800, 2200);
	// Large: 150-300 kg <-- 300-600 pounds -- centaurs/hoofed/trolls/etc
	else if (ch.size == 3) weight = .number_range(3000, 6000);
	// Huge: 325-500 kg <-- 650-1000 pounds -- giants/mid-size dragons
	else if (ch.size == 4) weight = .number_range(6500, 10000);
	// Giant: 600-900 kg <-- 1100-1800 pounds -- large dragons
	else if (ch.size == 5) weight = .number_range(11000, 18000);
	// Gargantuan: 1000-1500 kg <-- 2000-3000 pounds -- ancient dragons etc.
	else weight = .number_range(20000, 30000);
	
	if (.tmp.mob.isEthereal(ch)) weight = weight / 10;
	return weight / 10; // return weight in pounds
    };
    
    
    /////////////////////////////////////////////////////////////
    ////////////////////// BODY PARTS / FORMS ///////////////////
    /////////////////////////////////////////////////////////////
	
    // Shortcut helper to determine whether a character is blind
    // TO-DO (RUFFINA): Replace this with ch.blind implementation
    .tmp.mob.isBlind = function(ch) {
	return (ch.affected_by & .tables.affect_flags.blind);
    };

    // Can a ch greet vict: do the see them come and react?
    .tmp.mob.canGreet = function(ch, vict) {
	return (.tmp.mob.valid(vict) && .tmp.mob.awake(ch) &&
		!.tmp.mob.isBlind(ch) && ch.can_see_mob(vict) &&
		!(ch.detection & .tables.detect_flags.fear));
    };	
    
    // Determine whether a creature is capable of producing any sounds
    // Magical and sentient creatures can make sounds
    .tmp.mob.canMakeSound = function(ch) {
	if (!ch.is_npc() ||
	    ch.form & .tables.form_flags.sentient ||
	    ch.form & .tables.form_flags.magical) return true;	 
	    
	return (!(ch.form & .tables.form_flags.spider ||
		  ch.form & .tables.form_flags.blob ||
		  ch.form & .tables.form_flags.fish ||
		  ch.form & .tables.form_flags.worm ||
		  ch.form & .tables.form_flags.crustacean ||
		  ch.form & .tables.form_flags.insect));	    
    };

    // Additional checks whether ch was deactivated or silenced
    .tmp.mob.isSilent = function(ch) {
	return (!.tmp.mob.isActive(ch) ||
		!.tmp.mob.canMakeSound(ch) ||
		ch.isAffected("garble"));
    };
    
    // Determine whether a mob is capable of speaking:
    // non-silent PCs, sentients or magical creatures, not under water
    .tmp.mob.canSpeak = function(ch) {
	return (.tmp.mob.valid(ch) && ch.in_room != null
		&& !.tmp.mob.isSilent(ch)
		&& ch.in_room.sector_type != .tables.sector_table.underwater 
		&& (!ch.is_npc() || 
		     ch.form & .tables.form_flags.sentient ||
		     ch.form & .tables.form_flags.magical));
    };
    
    // TO-DO: add isDeaf helper -- is PC deaf flag, deafen, no ears, sleeping etc.

    // Determine whether a mob is capable of flying
    .tmp.mob.canFly = function(ch) {
	if (!.tmp.mob.valid(ch)) return false;
	if (ch.isAffected("fly") 
	    || ch.affected_by & .tables.affect_flags.flying) return true;
	if (ch.mount != null
	    && ch.riding
	    && .tmp.mob.canFly(ch.mount)) return true;
	return false;
    };
    
    .tmp.mob.isUndead = function(ch) {
	return ( (ch.is_npc() && (ch.act  & .tables.act_flags.undead || 
				  ch.form & .tables.form_flags.undead)) ||
		 (!ch.is_npc() && (ch.act & .tables.plr_flags.vampire)) );
    };
    
    .tmp.mob.isObject = function(ch) {
	if (ch.is_npc()) { 
	    if (ch.detection & .tables.detect_flags.form_tree ||   
		ch.detection & .tables.detect_flags.form_grass ||
		ch.race.name == "modron" ||	
		ch.race.name == "golem" ||
		ch.form & .tables.form_flags.construct)
		return true;
	}
	return false;
    };
    
    .tmp.mob.isEthereal = function(ch) {
	if (ch.is_npc()) { 
	    if (ch.form & .tables.form_flags.mist ||   
		ch.form & .tables.form_flags.intangible)
		return true;
	}
	else if (.tmp.player.ghost(ch)) return true;
	return false;
    };	
    
    // charm person: anyone except undeads/objects/nonadoptable
    // attract: charm person, only sentinels, only opposite sex
    // dominate: NPCs, except undeads/objects/ethereal/nonadoptable
    // control undead: only undeads/objects (including vampire PCs)
    // befriend: non-sentinels, except undeads/objects/nonadoptable
    .tmp.mob.isBloodless = function(ch) {
	return (ch == null ||
		.tmp.mob.isUndead(ch) ||
		.tmp.mob.isObject(ch) ||
		.tmp.mob.isEthereal(ch) ||
		(!(ch.parts & .tables.part_flags.heart) 
		 && !(ch.form & .tables.form_flags.cold_blood)));
    };
    
    // Check if a mob has legs and can be thrown to the ground.
    .tmp.mob.hasLegs = function(ch) {
	return .tmp.mob.hasPart(ch, "legs");
    };
    
    // Check if mob's arms should be called "paws": true for all non-sentient and dragons.
    .tmp.mob.hasPaws = function(ch) {
	return (!.tmp.mob.isObject(ch)
		&& (!(ch.form & .tables.form_flags.sentient) || 
		     (ch.form & .tables.form_flags.dragon)));
    };

    // Check if ch has active hands 
    .tmp.mob.hasHands = function(ch) {
	return (.tmp.mob.valid(ch) && .tmp.mob.hasPart(ch, "hands") && 
		ch.wearloc.split(' ').has("hands") &&
		(ch.wearloc.split(' ').has("wrist_l") ||
		 ch.wearloc.split(' ').has("wrist_r")));
    };
    
    // Check if ch has free hand to grab/catch or shoot bow
    .tmp.mob.hasFreeHand = function(ch) { 
	if (!.tmp.mob.hasHands(ch)) return false;
	var w; w = ch.get_eq_char("wield");
	if (w != null) {
	    if (ch.get_eq_char("hold") != null ||
		ch.get_eq_char("second_wield") != null ||
		ch.get_eq_char("shield") != null ||
		(w.hasWeaponFlag("two_hands") && ch.size < 4))
		    return false;
	}
	return true;
    };
    
    // Does ch have this part?
    .tmp.mob.hasPart = function(ch, bit_or_name) {
	if (ch == null || ch.parts == 0 || 
	    bit_or_name == null || bit_or_name == "")
	    return false; // sanity checks
	
	// Convert bit into name if needed
	var bit, partname; bit = .tmp.system.toNumber(bit_or_name);
	if (bit == null) partname = bit_or_name;
	else {
	    partname = .tables.part_flags.values(bit);
	    if (partname == null) return false; // sanity check if incorrect bit
	}
	
	var parts; parts = .tables.part_flags.names(ch.parts).arguments();
	for (p in parts)
	    if (p == partname) return true;
	
	return false;
    };
	
    // Returns body part prototype vnum from its bit or name
    .tmp.mob.partVnum = function(bit_or_name) {
	// sanity check: always return at least some vnum to create a part from
	if (bit_or_name == null || bit_or_name == "") return 191;
	
	var bit, name; bit = .tmp.system.toNumber(bit_or_vnum);
	if (bit == null) {
	    name = bit_or_name;
	    bit = .tables.part_flags.values(name); // check if part exists
	    if (bit == null) throw .fmt("Incorrect body part name: %s", name);
	}
	if      (name == "head")   return 12;
	else if (name == "heart")  return 13;
	else if (name == "arms")   return 14;
	else if (name == "legs")   return 15;
	else if (name == "guts")   return 16;
	else if (name == "brains") return 17;
	else                       return 191; // stub prototype for other parts
    };

    // Define "internal" body parts that can't be chopped off easily
    .tmp.mob.isInternalPart = function(part) {
	return (part == "heart" || part == "guts" 
		|| part == "brains" || part == "eye");
    };
    
    // Remove bodypart-based affects for NPCs
    .tmp.mob.checkPartAffects = function(ch) {
	if (!ch.is_npc()) return false;
	var m; m = .get_mob_index(ch.pIndexData.vnum).create();
	var result; result = false;
		
	if (!(ch.parts & .tables.part_flags.fins) &&
	    (m.parts & .tables.part_flags.fins) &&
	    (ch.affected_by & .tables.affect_flags.swim) &&
	    (m.affected_by & .tables.affect_flags.swim)) {
	    result = true;
	    ch.affected_by = .unset_bit(ch.affected_by, .tables.affect_flags.swim); 
	}
	    
	if (!(ch.parts & .tables.part_flags.wings) &&
	    (m.parts & .tables.part_flags.wings) &&
	    (ch.affected_by & .tables.affect_flags.flying) &&
	    (m.affected_by & .tables.affect_flags.flying)) {
	    ch.flydown();
	    ch.affected_by = .unset_bit(ch.affected_by, .tables.affect_flags.flying);
	    result = true;
	}
	m.extract(true);
	return result;
    };
    
    // Determine if ch can wear obj due to level/align
    // TO-DO (RUFFINA): remove this and add DefaultWearlocation::canWear instead
    .tmp.mob.wearCheck = function(ch, obj) {
	var msg; msg = "";
	
	// Can't wear due to align
	if ((ch.good && obj.extra_flags & .tables.extra_flags.anti_good) ||
	    (ch.neutral && obj.extra_flags & .tables.extra_flags.anti_neutral) ||
	    (ch.evil && obj.extra_flags & .tables.extra_flags.anti_evil))
	    msg = msg + ch.print(._("Твоя натура не позволяет тебе использовать %1$O4."), obj);
	
	// Can't wear due to level    
	if (obj.level > ch.level + ch.profession.wearModifier(obj.item_type))
	    msg = msg + ch.print(._("Тебе не хватает опыта, чтобы использовать %1$O4."), obj);
	
	// Can't wear limit -- too experienced
	if (obj.pIndexData.limit > 0 && obj.level < ch.modifyLevel - 20)
	    msg = msg + ch.print(._("Ты слишком опыт%1$Gен|ен|на, чтобы использовать %2$O4."), ch, obj);
	
	// Can't wear due to wearlocs
	if (!ch.is_npc()) {
	    var found; found = false;
	    for (w in obj.wearlocs)
		if (ch.hasWearloc(w.name)) found = true;
	    if (!found)
		msg = msg + ch.print(._("Тебе некуда надеть %1$O4."), obj);
	}
	
	return msg;
    };
	
    // Determine in character can wear obj: if wearloc matches ch's bodyparts
    .tmp.mob.canWear = function(ch, obj) {
	if (!.tmp.mob.valid(ch) || !.tmp.object.valid(obj)) return false;
	
	if (.tmp.mob.wearCheck(ch, obj) != "") return false;
	    
	// TO-DO: 
	// - fingers on leg paws
	// - hands attached to tentacles
	// - hold/shields in tentacles
	// - wrists on tentacles/legs(paws)
	if (obj.wear_loc == "finger_l" || obj.wear_loc == "finger_r")
	    return (.tmp.mob.hasPart(ch, "arms") &&
		    .tmp.mob.hasPart(ch, "hands") &&
		    .tmp.mob.hasPart(ch, "fingers"));
	else if (obj.wear_loc == "neck_1" || obj.wear_loc == "neck_2")
	    return (.tmp.mob.hasPart(ch, "head") &&
		    !(ch.form & .tables.form_flags.intangible));
	else if (obj.wear_loc == "body")
	    return (!(ch.form & .tables.form_flags.intangible));
	else if (obj.wear_loc == "head")
	    return (.tmp.mob.hasPart(ch, "head"));
	else if (obj.wear_loc == "legs")
	    return (.tmp.mob.hasPart(ch, "legs"));
	else if (obj.wear_loc == "feet")
	    return (.tmp.mob.hasPart(ch, "feet") &&
		    .tmp.mob.hasPart(ch, "legs"));
	else if (obj.wear_loc == "hands")
	    return (.tmp.mob.hasPart(ch, "hands") &&
		    .tmp.mob.hasPart(ch, "arms"));            
	else if (obj.wear_loc == "arms")
	    return (.tmp.mob.hasPart(ch, "arms"));
	else if (obj.wear_loc == "shield")
	    return (.tmp.mob.hasPart(ch, "hands") &&
		    .tmp.mob.hasPart(ch, "arms") &&
		    .tmp.mob.hasPart(ch, "fingers"));
	else if (obj.wear_loc == "about")
	    return true; // anyone can wear cloaks (for now)                   
	else if (obj.wear_loc == "waist")
	    return (!(ch.form & .tables.form_flags.intangible));
	else if (obj.wear_loc == "wrist_l" || obj.wear_loc == "wrist_r")
	    return (.tmp.mob.hasPart(ch, "arms"));
	else if (obj.wear_loc == "wield" || obj.wear_loc == "second_wield") 
	    // ghosts can wear weapons
	    return (.tmp.mob.isEthereal(ch) ||
			(.tmp.mob.hasPart(ch, "hands") &&
			.tmp.mob.hasPart(ch, "arms") &&
			.tmp.mob.hasPart(ch, "fingers")));
	else if (obj.wear_loc == "hold") 
	    // ghosts can hold items (but not shields)
	    return (.tmp.mob.isEthereal(ch) ||
			(.tmp.mob.hasPart(ch, "hands") &&
			.tmp.mob.hasPart(ch, "arms") &&
			.tmp.mob.hasPart(ch, "fingers")));
	else if (obj.wear_loc == "float")
	    return true; // anyone can wear floats                      
	else if (obj.wear_loc == "light")
	    return true; // anyone can wear lights 
	else if (obj.wear_loc == "tattoo")
	    return (!(ch.form & .tables.form_flags.intangible));
	else if (obj.wear_loc == "face")
	    return (.tmp.mob.hasPart(ch, "head"));
	else if (obj.wear_loc == "ears")
	    return (.tmp.mob.hasPart(ch, "ear"));
	else if (obj.wear_loc == "horse")
	    return (.tmp.mob.hasPart(ch, "four_hooves") &&
		    !(ch.form & .tables.form_flags.intangible));
	else if (obj.wear_loc == "hooves")
	    return (.tmp.mob.hasPart(ch, "two_hooves") ||
		    .tmp.mob.hasPart(ch, "four_hooves"));
	else if (obj.wear_loc == "hair")
	    return (.tmp.mob.hasPart(ch, "head") &&
		    ch.form & .tables.form_flags.mammal);
	else return true; // no more specifics for now
    };
    
    // Determine if ch has any item with given wearloc
    // Use for newbie outfit and similar quests
    .tmp.mob.hasObjWearloc = function(ch, wearloc) {
	for (item in ch.items)
	    if (.tmp.object.hasWearloc(item, wearloc)) return true;
	return false;
    };
	
    /////////////////////////////////////////////////////////////
    ////////////////////// IN COMBAT ////////////////////////////
    /////////////////////////////////////////////////////////////
    
    // Can the ch fall prone?
    .tmp.mob.canFall = function(ch) {
	// Can't fall if without legs or material body
	if (!.tmp.mob.valid(ch)
	    || ch.position <= .tables.position_table.rest
	    || !(ch.parts & .tables.part_flags.legs) 
	    || .tmp.mob.isEthereal(ch) 
	    || ch.flying)
	    return false;
	
	var room; room =  ch.in_room;
	if (room == null) return false; // sanity check
	
	// Can't fall in the air or while swimming (yet?)    
	if (room.sector_type == .tables.sector_table.air ||
	    room.sector_type == .tables.sector_table.underwater ||
	    room.sector_type == .tables.sector_table.water_swim)
	    return false;
	    
	return true;
    };
    
    // Check if char has weapon.
    // If yes, use weapon.attack_damage, otherwise ch.attack_damage
    // Weaponless player always returns "bash" -- TO-DO: change for claws etc.
    .tmp.mob.getAttackDamage = function(ch) {
	var weapons; weapons = .List();
	weapons = .tmp.mob.getWeapons(ch);
	if (weapons.size() == 0) return ch.attack_damage;
	else return weapons.front().attack_damage;
    };
    
    .tmp.mob.getWeapons = function(ch) {
	var w, sw, weapons; weapons = .List();
	w = ch.get_eq_char("wield");
	sw = ch.get_eq_char("second_wield");
	if (w != null) weapons.add(w);
	if (sw != null) weapons.add(sw);
	return weapons;
    };

    // Returns skill proficiency with current weapon
    .tmp.mob.getWeaponSkill = function(ch) {
	var skill; skill = .Skill("hand to hand");
	var skill_name; skill_name = "hand to hand";
	if (.tmp.mob.valid(ch)) {
	    if (!ch.is_npc()) {
		var w; w = ch.get_eq_char("wield");
		if (w != null) skill_name = .tmp.object.getWeaponClass(w);
		if (skill_name == "exotic") // TO-DO: This is pretty crazy, nerf it
		    return .min(100, ch.modifyLevel * .max(1, (3 + (ch.cur_int - 20))));
		else if (skill_name != "stone" && skill_name != "arrow")
		    skill = .Skill(skill_name);
		if (skill.usable(ch))
		    return skill.effective(ch);
	    }
	    else return 100; // always 100% for NPCs
	}
	return 0;
    };
	
    .tmp.mob.hasWeaponType = function(ch, weapon_type) {
	var weapons; weapons = .List();
	weapons = .tmp.mob.getWeapons(ch);
	if (weapons.size() == 0) return false;	
	for (w in weapons)
	    if (.tmp.object.getWeaponClass(w) == weapon_type)
		return true;
	return false;
    };
    
    // return current hitpoints in percentage to maximum
    .tmp.mob.health = function(ch) {
	if (!.tmp.mob.valid(ch) || ch.max_hit == 0) return 0;
	return (.max(0, (ch.hit * 100) / ch.max_hit));
    };

    /////////////////////////////////////////////////////////////
    ////////////////////// ADVANCED /////////////////////////////
    /////////////////////////////////////////////////////////////

    // Is master alive and in the same room?
    .tmp.mob.masterHere = function(mob) {
	return (.tmp.mob.valid(mob) 
		&& mob.is_npc()
		&& mob.master != null
		&& .tmp.mob.valid(mob.master)
		&& mob.master.in_room == mob.in_room);	    
    };
    
    // Replace NPC killer with their master if master is in the same room
    .tmp.mob.getKillerHere = function(killer) {
	if (killer == null || !.tmp.mob.valid(killer)) return null;
	if (!killer.is_npc()) return killer;
	if (.tmp.mob.masterHere(killer)) return killer.master;

	return killer;
    };
    
    // Auto-cast spells onSpec only if everyone's is fighting in the same room
    .tmp.mob.canAutoCast = function(mob) {
	return (.tmp.mob.isActive(mob)
		&& .tmp.mob.masterHere(mob)
		&& mob.pc == null // Not allowed during shapeshifting
		&& mob.fighting != null
		&& mob.master.fighting != null);	    
    };
    
    // Additional checks to make sure both victim and mob are in the same place
    .tmp.mob.canCastOn = function(mob, vict) {
	return (.tmp.mob.valid(vict)
		&& vict.in_room == mob.master.in_room
		&& vict.in_room == mob.in_room
		&& vict.fighting != null); // Auto-cast only in combat   
    };	
    // Can cast support only on group members
    .tmp.mob.canCastSupport = function(mob, vict) {
	return (.tmp.mob.canAutoCast(mob)
		&& .tmp.mob.canCastOn(mob, vict)
		&& vict.is_same_group(mob));
    };
    
    // Can cast offensive only if victim is fighting any group member
    .tmp.mob.canCastOffensive = function(mob, vict) {
	return (.tmp.mob.canAutoCast(mob)
		&& .tmp.mob.canCastOn(mob,vict)
		&& mob.fighting == vict
		&& vict.fighting.is_same_group(mob)
		&& !vict.is_safe(mob));
    };
    
    // Check if mob has any special service occupation (except battlehorse).
    // NB: ch.hasDestiny consists of this + battlehorse + quest mobs
    .tmp.mob.hasService = function(ch) {
	return (ch.is_npc() &&
		// Old service behaviors
		(ch.hasOccupation("shopper") || ch.hasOccupation("practicer") ||
		 ch.hasOccupation("repairman") || ch.hasOccupation("quest_trader") ||
		 ch.hasOccupation("quest_master") || ch.hasOccupation("healer") ||
		 ch.hasOccupation("blacksmith") || ch.hasOccupation("trainer") ||
		 ch.hasOccupation("clanguard") || ch.hasOccupation("adept") ||
		 .tmp.mob.isServicer(ch)));
    };
    
    // Check if mob has new service behaviors
    .tmp.mob.isServicer = function(ch) {
	return (ch.is_npc() &&
		(ch.pIndexData.behaviors.has("healer") || 
		 ch.pIndexData.behaviors.has("blacksmith") ||
		 ch.pIndexData.behaviors.has("enchanter") || 
		 ch.pIndexData.behaviors.has("sage")));
    };

    // determine whether any ch can rescue victim in battle
    .tmp.mob.canRescue = function(ch, victim, verbose) {
	var msg; msg = "";
	var enemy; enemy = victim.fighting;
	
	if (ch.fighting == null)
	    msg = ch.print(._("Но ты сейчас не сражаешься!"));
	else if (victim == null || !ch.can_see_mob(victim))
	    msg = ch.print(._("Ты не видишь, кого спасать."));
	else if (enemy == null)
	    msg = ch.print(._("Но %1$C1 сейчас не сража%1$nется|ются!"), victim);
	else if (enemy == ch)
	    msg = ch.print(._("Перед тем, как спасать %1$C4, наверное стоит перестать %1$P2 мутузить."), victim);
	else if (ch == victim)
	    msg = ch.print(._("Чтобы спасти себя от этого противника, попробуй просто {1{y{hcубежать{x{2."));
	else if (!victim.is_npc() && !victim.is_same_group(ch))
	    msg = ch.print(._("Чтобы спасать %1$C4, нужно сначала вступить с %1$P5 в группу."), victim);
	else if (ch.is_safe(enemy))
	    msg = ch.print(._("Ты не можешь вступить в бой против %1$C4."), enemy);
	else if (!ch.is_npc() && ch.shadow > 0)
	    msg = ch.print(._("Эта странная тень не дает тебе понять, кого спасать."));
	else if (enemy.is_npc() && (enemy.off_flags & .tables.off_flags.area_attack))
	    msg = ch.print(._("Отвлечь %1$C4 не выйдет -- %1$P1 атаку%1$nет|ют всех сразу."), enemy);
	else if (victim.dead)
	    msg = ch.print(._("%^C4 уже поздно спасать."), victim);
	else if (enemy.dead)
	    msg = ch.print(._("%^C4 незачем спасать -- %C1 уже труп!"), victim, enemy);
	else if (ch.is_npc() && ch.pc != null)
	    msg = ch.print(._("В чужом теле спасти никого не получится."));
	    
	if (msg != "") {
	    if (verbose) {
		ch.act(msg);
		ch.echoMaster(msg);
	    }
	    return false;
	}	
	return true;
    };
    
    // determine whether a follower can rescue their master
    .tmp.mob.canRescueMaster = function(ch) {
	return (.tmp.mob.masterHere(ch)
		&& ch.fighting != null && ch.master.fighting != null
		&& ch.fighting != ch.master
		&& .tmp.mob.valid(ch.master.fighting)
		&& ch.master.in_room == ch.master.fighting.in_room
		&& ch.master.fighting.fighting == ch.master
		&& ch.can_see_mob(ch.master.fighting)
		&& !ch.is_safe(ch.master.fighting)
		&& ch.master.fighting.is_npc() // don't auto-save vs. PC/PK
		&& !(ch.master.fighting.off_flags & .tables.off_flags.area_attack));
    };

    .tmp.mob.get_obj_behavior = function(mob, bhv) {
	for (i in mob.inventory) {
	    if (i.in_obj != null) continue;
	    if (i.hasBehavior(bhv)) return i;
	}
		
	return null;
    };
    
    .tmp.mob.sameAlign = function(ch, vict) {
	return (   (ch.good && vict.good) 
		|| (ch.neutral && vict.neutral)
		|| (ch.evil && vict.evil));
    };

    .tmp.mob.oppositeAlign = function(ch, vict) {
	return (   (ch.good && vict.evil) 
		|| (ch.evil && vict.good));
    };
    
    // Mob attempts to remove and drop burning/heated item, gets damage
    // Visualize removal/dropping/damage, return damage
    // Apply damage outside if apply_damage is false
    .tmp.mob.burnByItem = function(ch, obj, apply_damage) {
	if (!.tmp.mob.valid(ch) || !.tmp.object.valid(obj)) return 0;
	if (ch.isImmune("fire", "")) return 0;
	if (.tmp.player.ghost(ch) || .tmp.player.protected(ch)) return 0;
	
	var iaff; iaff = .Affect();	
	var fire_power; fire_power = 1;
	// find if obj is heated -- if not, it's burning
	if (obj.isAffected("incandescent")) {
	    for (a in obj.affected) 
		if (a.type == "incandescent") iaff = a;
	    fire_power = .max(1, iaff.duration);
	    
	    if (ch.isAffected("protection heat")) 
		return 0; // No heat damage if ch is protected
	} 
	// damage from open fire, not heat, so no protection
	else if (.tmp.object.canBurn(obj)) 
	    fire_power = .max(1, obj.material.burns); 
	    
	var remove, drop, dam;
	// dex increases the chance to remove on time to reduce damage
	// heavy weight reduces the chance to remove
	remove = .number_range(1, 20) + (ch.cur_dex - 20) * 2;
	remove = .max(1, remove - .number_range(1, obj.weight/10));
	// CON decreases chances to drop (resist pain)
	drop = .number_range(1, 20) + (ch.cur_con - 20) * 2 + obj.weight/10;
	
	if (obj.carried_by == ch)
	    dam = .dice(.number_range(obj.level / 2, obj.level), fire_power * 2);
	else dam = ch.max_hit / 100; // quick burn
	
	// If ch removes item --> dam/2		
	if (obj.carried_by == ch && obj.worn && .tmp.object.canRemove(obj) && .chance(remove) && obj.remove()) {
	    ch.act(._("Ты едва успеваешь содрать с себя раскаленн%1$Gое|ый|ую|ые %1$O4!"), obj);
	    ch.recho(._("%2$^C1 едва успева%2$nет|ют содрать с себя раскаленн%1$Gое|ый|ую|ые %1$O4!"), obj, ch);
	    dam = dam / 2;
	}
	
	// If removes and drops --> no damage
	if (obj.carried_by == ch && !obj.worn && ch.can_drop_obj(obj) && .chance(drop)) {
	    dam = 0;
	    .tmp.object.dropObj(ch, obj, true, null); 
	    // Update incandescent after dropping: e.g., cool down by water
	    if (iaff != null && .tmp.object.valid(obj)) // obj can be sunk after dropping
		.AffectHandler("incandescent").onUpdateObj(obj, iaff);
	}
	
	if (dam > 0) {
	    ch.act(._("Раскаленн%1$Gое|ый|ая|ые %1$O1 обжига%1$nет|ют твою кожу!"), obj);
	    ch.recho(._("Раскаленн%1$Gое|ый|ая|ые %1$O1 обжига%1$nет|ют кожу %2$C2."), obj, ch);
	}
	
	if (dam > 0 && apply_damage) {
	    if (iaff != null && iaff.source != null && !iaff.source.is_safe(ch))
		iaff.damage(ch, dam, iaff.type, "fire", "spell"); // PK damage if possible
	    else ch.rawdamage(ch, dam, "fire", "self");
	}
	
	return dam;
    };

    // fire_effect analog from C++: blind, blow gear, but don't damage unless apply_damage
    // heat items unless heat_items is false
    // Now depends on fire power, not fire damage dealt
    .tmp.mob.effectFire = function(ch, fire_power, heat_items, apply_damage) {
	if (!.tmp.mob.valid(ch)) return;
	var room; room = ch.in_room;
	// What the caller asked for, kept for decisions that must not drift with
	// the weather -- see the thirst gate below
	var source_power; source_power = fire_power;
	// The surroundings feed or fight the element before anything else does.
	// A brand against skin is a CONTACT source: the weather is a nudge at
	// the interface, clamped to one point either way, and only a genuinely
	// impossible room (underwater) deletes the effect. Rain used to erase a
	// power-2 proc outright -- 2 - 2 = 0 and the whole body was skipped.
	var emod; emod = .tmp.room.elementModKind(room, "fire", "contact");
	if (emod <= -100) return; // underwater: nothing to burn, nothing to blind
	fire_power = .urange(1, fire_power + emod, 10);
	var to_save; to_save = .urange(1, 100 - fire_power * 10, 99);
	var items_affected; items_affected = 0; // capped by fire_power

	// Burn/heat gear first -- so that ch could see it
	// NB: Immunity to fire or protection prevents damage to ch, not to items
	for (obj in ch.items) {
	    if (!heat_items) break;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    // Chance to burn anything depends on fire_power
	    if (.tmp.chance(to_save, ch)) break;
	    var wasHot; wasHot = obj.isAffected("incandescent");
	    if (!.tmp.object.applyHeat(obj, null, null, fire_power, false))
		continue; // didn't affect item? let's try another one

	    if (!.tmp.mob.valid(ch)) return; // double-check if ch is still alive

	    // applyHeat runs quiet here on purpose -- this is ambient heat, and
	    // its verbose lines are written for someone deliberately heating a
	    // thing. But gear going red-hot is a state the owner then takes
	    // damage from, and only cooling down ever announced itself
	    // (incandescent/onUpdateObj), so the pair was one-sided. Fires once,
	    // on the transition: canHeat() refuses an already-glowing object.
	    if (!wasHot && .tmp.object.valid(obj) && obj.isAffected("incandescent")
		&& room != null)
		room.echo(._("%1$^O1 раскаля%1$nется|ются докрасна."), obj);

	    if (apply_damage && items_affected >= .urange(1, fire_power / 4, 3)) break;
	    else if (items_affected >= .urange(1, fire_power / 3, 4)) break; // higher cap for DOT
	    else items_affected = items_affected + 1;
	}
	
	if (ch.isAffected("protection heat")) return;

	if (ch.isImmune("fire", ""))
	    return; // no effect if protected
	
	// DAMAGE, if applicable -- use for DOT (e.g. heat affect)
	if (apply_damage) {
	    var dam; dam = .dice(ch.level, fire_power * 2);
	    // find if room is heated
	    var aff; aff = .Affect();	
	    if (room.isAffected("heat")) {
		for (a in room.affected) 
		    if (a.type == "heat") aff = a;
	    }
	    if (aff != null && aff.source != null && !aff.source.is_safe(ch))
		aff.damage(ch, dam, aff.type, "fire", "other"); // PK damage if possible
	    else ch.rawdamage(ch, dam, "fire", "self");
	    if (!.tmp.mob.valid(ch)) return; // check if ch is still alive
	}

	if (ch.isAffected("chill touch") && .chance(50 + fire_power))
	    ch.affectStrip("chill touch", true); // dispel frostbite
	    
	// Heat makes Jack thirsty. Two traps live on this one line.
	// The setter GAINS what it is given (desire->gain), it does not assign,
	// so feeding the current reading back in gains the whole bar twice over.
	// And the scale runs -6 (dying of thirst) to 96 (sated), so a PENALTY has
	// to be NEGATIVE: the legacy effects.cpp passed a positive dam/20 under a
	// "getting thirsty" comment, which quenched thirst instead.
	// Only a real blaze or a real spell parches -- a flaming sword lands
	// several times a round and would outdrain the burning room it started.
	// Gated on the REQUESTED power, not the modulated one: a flaming blade
	// is power 2 whether or not the room it swings in happens to be hot.
	if (!ch.is_npc() && source_power >= 4)
	    ch.cond_thirst = -1 * .max(1, source_power / 4);
	
	if (.tmp.mob.isBlind(ch)
	    || !(ch.parts & .tables.part_flags.eye) 
	    || (ch.parts & .tables.part_flags.eyestalks))
	    return; // can't blind if eyestalks, no eyes, or already blind
	    
	if (!ch.saves_spell(ch, fire_power * 10, "fire")) {
	    ch.act(._("{WТвои глаза слезятся от раскаленного воздуха. Ты ничего не видишь!{x"));
	    ch.recho(._("%1$^O1 слепн%1$nет|ут от раскаленного воздуха!"), ch);
	    var af; af = .Affect();
	    af.type             = "heat";
	    af.level            = fire_power * 10 + 1;
	    af.duration         = fire_power/2 + 1;
	    af.bitvector("affect_flags", "blind");		
	    af.location         = .tables.apply_flags.hitroll;
	    af.modifier         = -1 * .max(4, fire_power + 1);
	    ch.affectAdd(af);
	}

	// Setting the ROOM alight belongs to .tmp.room.effectFire, not here.
	// This used to end with a createFire/burn roll at room_temperature =
	// fire_power, which meant a flaming sword had a couple of percent per
	// swing to start a bonfire in the tavern. Contact effects reach the
	// victim and the victim's gear; only area effects reach the room.
    };

    // Stack the chill touch affect the way affect_join did -- deeper and longer
    // with every new application -- but under a ceiling, which affect_join had
    // not. Legacy let a frost brand drain STR without bound over a long fight;
    // the port then over-corrected into refusing to refresh at all, so a proc on
    // an already-chilled target did nothing whatsoever.
    //
    // The ceiling is derived from the incoming application rather than fixed, so
    // no source can push the affect past twice what it manages on its own: a
    // power-2 frost proc tops out at -2 STR over 8 ticks, a level-60 chill touch
    // at -8 over 24. A weak source landing on a strong stack cannot lower it
    // either -- the result is never worse than what was already there.
    //
    // Returns true when it actually deepened or lengthened something, so the
    // caller can keep quiet instead of announcing a freeze that changed nothing.
    .tmp.mob.chillJoin = function(ch, af) {
	if (!.tmp.mob.valid(ch)) return false;

	// Read the stack as magnitudes: modifier is negative on the wire, and the
	// clamping below only reads right in the direction it means. Modifiers sum
	// because several affects all apply at once; durations do not, because the
	// longest one is how long the victim is actually chilled.
	var have_mod; have_mod = 0;
	var have_dur; have_dur = 0;
	var have_lev; have_lev = 0;
	for (aff in ch.affected) {
	    if (aff.type != "chill touch") continue;
	    // A permanent chill is somebody else's, and affectReplace below would
	    // delete it. Leave the whole thing alone rather than half-merge it.
	    if (aff.duration < 0) return false;
	    have_mod = have_mod - aff.modifier;
	    have_dur = .max(have_dur, aff.duration);
	    have_lev = .max(have_lev, aff.level);
	}

	var add_mod; add_mod = -1 * af.modifier;
	var new_mod; new_mod = .max(have_mod, .min(have_mod + add_mod, add_mod * 2));
	var new_dur; new_dur = .max(have_dur, .min(have_dur + af.duration, af.duration * 4));

	if (new_mod <= have_mod && new_dur <= have_dur)
	    return false; // already at the ceiling for a source this strong

	af.modifier = -1 * new_mod;
	af.duration = new_dur;
	af.level = .max(have_lev, af.level);
	ch.affectReplace(af); // collapses whatever was there into this one
	return true;
    };

    // The gear half of effectCold on its own. A caller that keeps its own
    // chill touch affect needs the freezing WITHOUT a second roll for the
    // affect: chill touch scales duration and the STR malus off the caster's
    // level, which the power argument cannot express, so the spell applies its
    // own affect and calls this for the gear. effectCold is this plus the
    // affect, and no caller should ever run both.
    .tmp.mob.effectColdGear = function(ch, cold_power, apply_damage) {
	if (!.tmp.mob.valid(ch)) return;
	// Contact source: a frost brand, a targeted spell. A wet target couples
	// to cold, so the water rows still help -- but only by a point, and no
	// room can switch a frost weapon off the way a burning room used to.
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "cold", "contact");
	if (emod <= -100) return; // no BLOCK exists for cold today; guarded anyway
	cold_power = .urange(1, cold_power + emod, 10);
	var to_save; to_save = .urange(1, 100 - cold_power * 10, 99);
	var items_affected; items_affected = 0; // capped by cold_power

	// NB: Immunity to cold or protection prevents damage to ch, not to items
	for (obj in ch.items) {
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    // Chance to freeze anything depends on cold_power
	    if (.tmp.chance(to_save, ch)) break;
	    if (!.tmp.object.applyCold(obj, null, cold_power, false))
		continue; // didn't affect item? let's try another one

	    if (!.tmp.mob.valid(ch)) return; // double-check if ch is still alive

	    if (apply_damage && items_affected >= .urange(1, cold_power / 4, 3)) break;
	    else if (items_affected >= .urange(1, cold_power / 3, 4)) break; // higher cap for DOT
	    else items_affected = items_affected + 1;
	}
    };

    // cold_effect analog from C++: freeze gear and chill the victim, but don't
    // damage unless apply_damage. Depends on cold power, not on damage dealt.
    // Cold power mirrors fire_power: 1 winter air, 2 frost weapon, 4 blizzard,
    // 8 frost spells, 10 white dragon breath.
    .tmp.mob.effectCold = function(ch, cold_power, freeze_items, apply_damage) {
	if (!.tmp.mob.valid(ch)) return;
	// What the caller asked for, kept for the hunger gate below
	var source_power; source_power = cold_power;
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "cold", "contact");
	if (emod <= -100) return; // no BLOCK exists for cold today; guarded anyway

	// Freeze gear first -- so that ch could see it
	if (freeze_items) {
	    .tmp.mob.effectColdGear(ch, cold_power, apply_damage);
	    if (!.tmp.mob.valid(ch)) return; // a bursting vessel can take the carrier with it
	}

	cold_power = .urange(1, cold_power + emod, 10);

	if (ch.isAffected("protection cold")) return;

	if (ch.isImmune("cold", ""))
	    return; // no effect if protected

	// DAMAGE, if applicable -- use for DOT (e.g. a future blizzard affect)
	if (apply_damage) {
	    var dam; dam = .dice(ch.level, cold_power * 2);
	    ch.rawdamage(ch, dam, "cold", "self");
	    if (!.tmp.mob.valid(ch)) return; // check if ch is still alive
	}

	// The cold sucks the warmth out of Jack, and Jack gets hungry. Negative
	// for the same reason as thirst in effectFire: the setter gains, and the
	// bar runs -6 (starving) to 96 (fed), so a penalty counts down. Gated on
	// the requested power too, or a frost blade would starve people all
	// winter on the strength of the season bonus alone.
	if (!ch.is_npc() && source_power >= 4)
	    ch.cond_hunger = -1 * .max(1, source_power / 4);

	if (!ch.saves_spell(ch, cold_power * 10, "cold")) {
	    var af; af = .Affect();
	    af.type		= "chill touch";
	    af.level		= cold_power * 10 + 1;
	    af.duration		= cold_power / 2 + 1;
	    af.location		= .tables.apply_flags.str;
	    af.modifier		= -1 * .max(1, cold_power / 3);
	    if (.tmp.mob.chillJoin(ch, af)) {
		ch.act(._("{CХолод окутывает тебя и проникает до самых костей.{x"));
		ch.recho(._("{CВолна холода пронизывает %1$C4.{x"), ch);
	    }
	}
    };

    // shock_effect analog from C++: discharge into gear and daze the victim,
    // but don't damage unless apply_damage. Depends on shock power, not damage.
    // Shock power mirrors fire_power: 1 static spark, 2 shocking weapon,
    // 4 shocking grasp, 8 lightning bolt, 10 blue dragon breath.
    .tmp.mob.effectShock = function(ch, shock_power, affect_items, apply_damage) {
	if (!.tmp.mob.valid(ch)) return;
	// Water conducts, so a discharge into a soaked victim hits far harder.
	// Shock is the one element whose contact clamp reaches +2 rather than
	// +1: a wet victim is not a bystander to the circuit, they ARE it.
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "shock", "contact");
	if (emod <= -100) return; // no BLOCK exists for shock today; guarded anyway
	shock_power = .urange(1, shock_power + emod, 10);
	var to_save; to_save = .urange(1, 100 - shock_power * 10, 99);
	var items_affected; items_affected = 0; // capped by shock_power

	// Discharge into the gear first -- so that ch could see it
	// NB: Immunity to lightning prevents damage to ch, not to items
	for (obj in ch.items) {
	    if (!affect_items) break;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    // Chance to hit anything depends on shock_power
	    if (.tmp.chance(to_save, ch)) break;
	    if (!.tmp.object.applyShock(obj, null, shock_power, false))
		continue; // didn't affect item? let's try another one

	    if (!.tmp.mob.valid(ch)) return; // double-check if ch is still alive

	    if (apply_damage && items_affected >= .urange(1, shock_power / 4, 3)) break;
	    else if (items_affected >= .urange(1, shock_power / 3, 4)) break; // higher cap for DOT
	    else items_affected = items_affected + 1;
	}

	if (ch.isImmune("lightning", ""))
	    return; // no effect if protected

	// DAMAGE, if applicable -- use for DOT (e.g. a future storm affect)
	if (apply_damage) {
	    var dam; dam = .dice(ch.level, shock_power * 2);
	    ch.rawdamage(ch, dam, "lightning", "self");
	    if (!.tmp.mob.valid(ch)) return; // check if ch is still alive
	}

	// Daze and confused: muscles lock up for a couple of rounds
	if (!ch.saves_spell(ch, shock_power * 10, "lightning")) {
	    ch.act(._("{BТвое тело парализовано.{x"));
	    ch.recho(._("{BТело %1$C2 сводит судорогой.{x"), ch);
	    // daze is measured in pulses, and setDaze in C++ only ever raises it
	    ch.daze = .max(ch.daze, .urange(8, shock_power * 2, 20));

	    // A big jolt travels up a METAL weapon and opens the hand. Gated
	    // hard, because this is the only PvP-relevant behaviour the port
	    // adds: power 8+ (lightning bolt and up -- a shocking blade is 2),
	    // a SECOND save that has to fail as well, and then a luck roll the
	    // victim can win. Water can carry a weaker spell over the line via
	    // elementMod -- which is why shock is the one element whose CONTACT
	    // clamp reaches +2 instead of +1, and the point of standing in a
	    // puddle: a galvanic whip is power 6 and gets there, a shocking
	    // blade is power 2 and never will.
	    //
	    // The second roll is at the SAME level as the first, deliberately.
	    // saves_spell is `40 + (mlevel - level) * 4 - ...`, so raising the
	    // attack level makes the save EASIER to fail: an earlier draft used
	    // power * 20, which pinned the roll to its 5% floor and passed 95%
	    // of everyone who failed the first one -- a rubber stamp wearing the
	    // word "gate". Same level means better saves protect you twice, which
	    // is what "failed by a wide margin" was asking for.
	    if (shock_power >= 8 && !ch.saves_spell(ch, shock_power * 10, "lightning"))
		.tmp.mob.shockDropWeapon(ch);
	}
    };

    // poison_effect analog from C++: venom in the bloodstream, and food left
    // dangerous to eat. Poison power mirrors the others: 1 tainted leftovers,
    // 2 a poisoned blade, 4 a drunkard's breath, 8 poison spells, 10 green
    // dragon breath.
    //
    // Deliberately the smallest of these engines. Legacy poison touched only
    // food and part-full drink containers, which is right -- venom needs a
    // bloodstream -- so the port keeps that shape instead of inventing one.
    // Poison is the one element where the victim-facing entry has to know HOW
    // the toxin arrived, because venom in a wound and gas in the lungs are
    // different physics behind the same signature. Fenia has no optional
    // arguments, so the delivery kind lives here and the two public entries
    // below are one-line wrappers -- callers keep the symmetric four-argument
    // shape every other effectX has.
    .tmp.mob.poisonRun = function(ch, poison_power, affect_items, apply_damage, kind) {
	if (!.tmp.mob.valid(ch)) return;
	// For a gas cloud the room decides a great deal: wind and rain scatter
	// it, a closed room holds it, cold air pools it at knee height. For
	// venom under the skin the room decides nothing at all, and the contact
	// row is empty by design -- rain does not wash poison out of a puncture
	// wound. (The weapon-flag branch in global/onWeaponEffect/weapons never
	// comes through here either way; it keeps its own inline affect.)
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "poison", kind);
	if (emod <= -100) return; // a gas cloud cannot form underwater
	poison_power = .urange(1, poison_power + emod, 10);

	// Foul what the victim is carrying FIRST, so they see it happen, and
	// before the immunity check -- being immune to poison protects the
	// character, not their lunch, exactly as it goes for fire and cold.
	// Two items at most: a single breath spoiling an entire pack is the
	// legacy behaviour this port exists to stop.
	// applyPoison takes a source_ch it never reads; the argument is there
	// to keep the four apply* signatures the same shape.
	var items_affected; items_affected = 0;
	for (obj in ch.items) {
	    if (!affect_items) break;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    if (!.tmp.object.applyPoison(obj, null, poison_power, true))
		continue;
	    // No valid(ch) re-check here, unlike the fire and cold loops:
	    // applyPoison only ever sets a bit, so it cannot kill the carrier
	    // the way an exploding potion can.
	    items_affected = items_affected + 1;
	    if (items_affected >= 2) break;
	}

	if (ch.isImmune("poison", ""))
	    return; // no effect if protected

	// DAMAGE, if applicable -- reserved for a future gas-room DOT
	if (apply_damage) {
	    var dam; dam = .dice(ch.level, poison_power * 2);
	    ch.rawdamage(ch, dam, "poison", "self");
	    if (!.tmp.mob.valid(ch)) return; // check if ch is still alive
	}

	if (!ch.saves_spell(ch, poison_power * 10, "poison")) {
	    ch.act(._("{gТебя начинает тошнить, когда яд проникает в твое тело.{x"));
	    ch.recho(._("{g%1$^C4 начинает тошнить, когда яд проникает в %1$P2 тело.{x"), ch);

	    var af; af = .Affect();
	    af.type		= "poison";
	    af.level		= poison_power * 10 + 1;
	    // Legacy gave duration level/2 -- 30 for a level-60 breath. Cap
	    // there, or power 10 would outlast anything the old code could do.
	    af.duration		= .urange(1, poison_power * 5, 30);
	    af.location		= .tables.apply_flags.str;
	    var str_mod; str_mod = -1;
	    if (poison_power >= 8) str_mod = -2;
	    af.modifier		= str_mod;
	    af.bitvector("affect_flags", "poison");
	    ch.affectJoin(af); // join, not add -- a second dose refreshes
	}
    };

    // acid_effect analog from C++: ruin the gear, etch the armour, no burns and
    // no blindness. Acid power mirrors the others: 1 vinegar, 2 an acid-coated
    // weapon, 4 vitriol, 6 caustic font, 8 acid spells, 10 black dragon breath.
    //
    // The character signature here is deliberately NOT a copy of fire's. Fire
    // blinds and parches; acid does neither. What acid does to a person wearing
    // metal is ruin what they are wearing, and applyAcid puts the corrosion
    // affect on armour itself -- so this function's whole job is to walk the
    // gear and let the object engine speak. ch.items covers inventory AND worn
    // equipment (characterwrapper.cpp), so the etch reaches armour without a
    // second pass over ch.equipment.
    .tmp.mob.effectAcid = function(ch, acid_power, affect_items, apply_damage) {
	if (!.tmp.mob.valid(ch)) return;
	// A splash at an interface barely cares about the weather -- it reacts in
	// seconds, long before a rinse arrives. A caustic mist very much does.
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "acid", "contact");
	if (emod <= -100) return;
	acid_power = .urange(1, acid_power + emod, 10);
	var to_save; to_save = .urange(1, 100 - acid_power * 10, 99);
	var items_affected; items_affected = 0;

	// Eat the gear first, so ch sees it happen, and before the immunity check:
	// being immune to acid protects the character, not their backpack, exactly
	// as it goes for fire and cold.
	for (obj in ch.items) {
	    if (!affect_items) break;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    if (.tmp.chance(to_save, ch)) break;
	    if (!.tmp.object.applyAcid(obj, null, acid_power, true))
		continue; // nothing happened to that one, try another

	    if (!.tmp.mob.valid(ch)) return; // a dissolving item can kill the carrier

	    if (apply_damage && items_affected >= .urange(1, acid_power / 4, 3)) break;
	    else if (items_affected >= .urange(1, acid_power / 3, 4)) break; // DOT cap
	    else items_affected = items_affected + 1;
	}

	if (ch.isImmune("acid", ""))
	    return; // no effect if protected

	// DAMAGE, if applicable -- reserved for a future acid-pool DOT
	if (apply_damage) {
	    var dam; dam = .dice(ch.level, acid_power * 2);
	    ch.rawdamage(ch, dam, "acid", "self");
	    if (!.tmp.mob.valid(ch)) return;
	}

	// No affect to hang on the character: legacy acid had none, and the
	// lingering cost is the corroded armour, which is where it belongs. This
	// line is the flavour that tells the victim why their gear is hissing.
	if (items_affected > 0) {
	    ch.act(._("{gЕдкая кислота шипит, разъедая все, чего коснулась.{x"));
	    ch.recho(._("{gЕдкая кислота шипит на %1$P2 снаряжении.{x"), ch);
	}
    };

    // Venom delivered at an interface: a poisoned blade, an envenomed arrow, a
    // touch spell. Weatherproof on purpose -- see poisonRun.
    .tmp.mob.effectPoison = function(ch, poison_power, affect_items, apply_damage) {
	.tmp.mob.poisonRun(ch, poison_power, affect_items, apply_damage, "contact");
    };

    // A toxin the victim breathes: gas cones, poison clouds, a future gas-room
    // DOT. Everything the weather does to a cloud applies to these.
    .tmp.mob.effectPoisonCloud = function(ch, poison_power, affect_items, apply_damage) {
	.tmp.mob.poisonRun(ch, poison_power, affect_items, apply_damage, "area");
    };

    // sand_effect analog from C++: blind the victim, scour their gear, no burns.
    // Sand power mirrors the others: 1 a handful of grit, 2 a dust devil,
    // 4 a steady desert wind, 6 desert fist, 8 a desert sandstorm, 10 a
    // wall-of-sand hurricane.
    //
    // Like poison, sand needs BOTH delivery kinds behind one signature: a fist
    // of sand pressed and thrown is contact, a storm the victim is standing
    // inside is an airborne cloud, and the weather should modulate the second
    // far more than the first. Fenia has no optional arguments, so the kind
    // lives in the runner and the two public entries are one-liners.
    .tmp.mob.sandRun = function(ch, sand_power, affect_items, apply_damage, kind) {
	if (!.tmp.mob.valid(ch)) return;
	var source_power; source_power = sand_power;
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "sand", kind);
	if (emod <= -100) return; // standing water, a flood: it is mud, not sand
	sand_power = .urange(1, sand_power + emod, 10);
	var to_save; to_save = .urange(1, 100 - sand_power * 10, 99);
	var items_affected; items_affected = 0;

	// Scour the gear first, so ch sees it happen. Note what is NOT here: no
	// path in applySand extracts an item outright, so a storm can wear a cloak
	// through over many exposures but can never eat a backpack in one.
	for (obj in ch.items) {
	    if (!affect_items) break;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    if (.tmp.chance(to_save, ch)) break;
	    if (!.tmp.object.applySand(obj, null, sand_power, true))
		continue;

	    if (!.tmp.mob.valid(ch)) return;

	    if (apply_damage && items_affected >= .urange(1, sand_power / 4, 3)) break;
	    else if (items_affected >= .urange(1, sand_power / 3, 4)) break;
	    else items_affected = items_affected + 1;
	}

	// DAMAGE, if applicable -- reserved for a future sandstorm room affect
	if (apply_damage) {
	    var dam; dam = .dice(ch.level, sand_power * 2);
	    ch.rawdamage(ch, dam, "slash", "self");
	    if (!.tmp.mob.valid(ch)) return;
	}

	// Dust in the throat. Negative because the setter GAINS and the bar runs
	// -6 (dying of thirst) to 96 (sated) -- the same trap fire's thirst line
	// documents. Gated on the REQUESTED power so a desert bonus cannot make a
	// thrown handful of grit parch anybody.
	if (!ch.is_npc() && source_power >= 4)
	    ch.cond_thirst = -1 * .max(1, source_power / 4);

	if (.tmp.mob.isBlind(ch)
	    || !(ch.parts & .tables.part_flags.eye)
	    || (ch.parts & .tables.part_flags.eyestalks))
	    return; // can't blind if eyestalks, no eyes, or already blind

	// Grit in the eyes. The legacy save was against DAM_SLASH and the affect
	// is the sand storm skill's own (generic-skills/sand storm.xml), both kept.
	if (!ch.saves_spell(ch, sand_power * 10, "slash")) {
	    ch.act(._("{yТвои глаза слезятся от набившегося в них песка. Ты ничего не видишь!{x"));
	    ch.recho(._("%1$^C1 ничего не видит из-за песка, попавшего в глаза!"), ch);
	    var af; af = .Affect();
	    af.type		= "sand storm";
	    af.level		= sand_power * 10 + 1;
	    af.duration		= sand_power / 2 + 1;
	    af.bitvector("affect_flags", "blind");
	    af.location		= .tables.apply_flags.hitroll;
	    af.modifier		= -1 * .max(4, sand_power);
	    ch.affectAdd(af);
	}
    };

    // A fist of sand, a thrown handful: contact.
    .tmp.mob.effectSand = function(ch, sand_power, affect_items, apply_damage) {
	.tmp.mob.sandRun(ch, sand_power, affect_items, apply_damage, "contact");
    };

    // A storm the victim is standing inside: an airborne cloud.
    .tmp.mob.effectSandCloud = function(ch, sand_power, affect_items, apply_damage) {
	.tmp.mob.sandRun(ch, sand_power, affect_items, apply_damage, "area");
    };

    // scream_effect analog from C++: deafen, daze, break off the fight, and
    // shatter whatever glass the victim is carrying. Scream power mirrors the
    // others: 1 an angry yell, 4 the note that cracks a wineglass, 8 the scream
    // spell point blank, 10 a dragon's roar.
    //
    // Kind is NOT a parameter here and elementModKind is asked for "area" even
    // though this is the victim-facing entry. That is deliberate: sound is
    // always delivered through the medium. There is no such thing as contact
    // acoustics -- a scream at point-blank range underwater still travels
    // through water, and the water is exactly what makes it worse.
    .tmp.mob.effectScream = function(ch, scream_power, affect_items, apply_damage) {
	if (!.tmp.mob.valid(ch)) return;
	var emod; emod = .tmp.room.elementModKind(ch.in_room, "scream", "area");
	if (emod <= -100) return; // no BLOCK exists for sound; guarded anyway
	scream_power = .urange(1, scream_power + emod, 10);
	var to_save; to_save = .urange(1, 100 - scream_power * 10, 99);
	var items_affected; items_affected = 0;

	for (obj in ch.items) {
	    if (!affect_items) break;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    if (.tmp.chance(to_save, ch)) break;
	    if (!.tmp.object.applyScream(obj, null, scream_power, true))
		continue;

	    if (!.tmp.mob.valid(ch)) return; // a bursting potion can kill the carrier

	    if (apply_damage && items_affected >= .urange(1, scream_power / 4, 3)) break;
	    else if (items_affected >= .urange(1, scream_power / 3, 4)) break;
	    else items_affected = items_affected + 1;
	}

	if (ch.isImmune("sound", ""))
	    return; // no effect if protected

	if (apply_damage) {
	    var dam; dam = .dice(ch.level, scream_power * 2);
	    ch.rawdamage(ch, dam, "sound", "self");
	    if (!.tmp.mob.valid(ch)) return;
	}

	if (ch.saves_spell(ch, scream_power * 10, "sound")) return;

	// 1: deafness. The scream skill exists (generic-skills/scream.xml) and
	// AFF_SCREAM is bits.conf:101.
	if (!ch.isAffected("scream")) {
	    ch.act(._("{MТы ничего не слышишь!{x"));
	    ch.recho(._("%1$^C1 теперь ничего не слышит."), ch);
	    var af; af = .Affect();
	    af.type		= "scream";
	    af.level		= scream_power * 10 + 1;
	    af.duration		= .urange(0, scream_power / 4, 2);
	    af.bitvector("affect_flags", "scream");
	    ch.affectAdd(af);
	}

	// 2: half the time the note also rattles the head. setDaze in C++ only
	// ever raises, so mirror that with max rather than assignment.
	if (.chance(50)) {
	    ch.act(._("{WТы ошеломленно трясешь головой!{x"));
	    ch.recho(._("%1$^C1 ошеломленно трясет головой."), ch);
	    ch.daze = .max(ch.daze, .urange(8, scream_power * 2, 20));
	}

	// 3: and it breaks concentration on the fight, which is the whole reason
	// warlocks and witches carry it -- the help article promises exactly this.
	if (ch.fighting != null) {
	    ch.act(._("Дикий вопль заставляет тебя отвлечься от сражения!"));
	    ch.recho(._("Дикий вопль заставляет %1$C4 отвлечься от сражения!"), ch);
	    ch.stop_fighting(true);
	}
    };

    // Knock a cramped hand's weapon loose. This mirrors the success branch of
    // SkillCommand("disarm").apply deliberately: canRemove refuses a NOREMOVE
    // weapon, can_drop_obj keeps nodrop gear in the inventory instead of
    // deleting it, and the off-hand weapon is promoted -- skip that last step
    // and the victim fights on with an empty main hand and a full off-hand.
    .tmp.mob.shockDropWeapon = function(ch) {
	var room; room = ch.in_room;
	if (room == null) return false;

	var weapon; weapon = ch.get_eq_char("wield");
	if (!.tmp.object.valid(weapon)) return false;
	if (!weapon.material.metal) return false; // a wooden haft insulates
	if (!.tmp.object.canRemove(weapon)) return false;

	// Godiva's patrons cannot be disarmed. That is a promise they paid for,
	// and SkillCommand("disarm").checkActors honours it -- a lightning bolt
	// must not be the loophole. Visible, like the disarm refusal is.
	if (.tmp.religion.hasPatron(ch, "godiva", false)) {
	    ch.act(._("{DПризрачная аура{x удерживает %1$O4 в твоей сведенной руке."), weapon);
	    return false;
	}

	// Luck fights the spasm -- the avoidance idiom, and ch is the one
	// avoiding, so the luck is theirs to spend
	if (.tmp.chance(20, ch)) return false;

	weapon.unequip();
	var dropped; dropped = ch.can_drop_obj(weapon);
	if (dropped) .tmp.object.dropObj(null, weapon, false, room);

	if (dropped) {
	    ch.act(._("{BСудорога разжимает твою ладонь, и %1$O1 со звоном пада%1$nет|ют %2$s!{x"),
		weapon, .tmp.room.dropWhere(room));
	    ch.recho(._("{BСудорога разжимает ладонь %1$C2, и %2$O1 со звоном пада%2$nет|ют %3$s!{x"),
		ch, weapon, .tmp.room.dropWhere(room));
	}
	else {
	    ch.act(._("{BСудорога разжимает твою ладонь, и %1$O1 выскальзыва%1$nет|ют из пальцев.{x"),
		weapon);
	    ch.recho(._("{BСудорога разжимает ладонь %1$C2, и %2$O1 выскальзыва%2$nет|ют из пальцев.{x"),
		ch, weapon);
	}

	var sw; sw = ch.get_eq_char("second_wield");
	if (sw != null) {
	    ch.act(._("Ты перехватываешь %1$O4 в основную руку."), sw);
	    ch.recho(._("%1$^C1 перехватыва%1$nет|ют %2$O4 в основную руку."), ch, sw);
	    sw.unequip();
	    sw.wear("wield");
	}

	return true;
    };
})