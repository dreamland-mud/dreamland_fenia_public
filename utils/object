// Simple/basic object and material helpers

.apply(function() {
    if (.tmp.object == null) .tmp.object = .Map();
    
    // Return 'true' if item has some sort of behavior
    .tmp.object.special = function(obj) {
	var triggers; triggers = obj.pIndexData.triggers;
	
	return triggers.has("onUse") || triggers.has("postUse")
		|| triggers.has("onFight")
		|| triggers.has("onEquip")
		|| triggers.has("onSpec");
    };

    // Rarity tier: 1 legendary .. 5 common, from the random-loot prop "tier" or
    // hero gear questTier (0..3 -> uncommon, rare, epic, epic); 0 = hand-made.
    .tmp.object.rarityTier = function(obj) {
	var t; t = obj.property("tier", "");
	if (t == "") {
	    var qt; qt = obj.property("questTier", "");
	    if (qt == "") return 0;
	    if (qt == "0") return 4;
	    if (qt == "1") return 3;
	    return 2;
	}
	if (t == "1") return 1;
	if (t == "2") return 2;
	if (t == "3") return 3;
	if (t == "4") return 4;
	return 5;
    };

    // Repair price in silver: pay for the damage only, scaled by item level and
    // rarity. fight/item_value measure.repair_cm = silver per item level at 100%
    // damage for tier 1..5; hand-made items count as uncommon. At least 1 gold.
    .tmp.object.repairPrice = function(obj) {
	var t, k, cm, dmg;
	t = .tmp.object.rarityTier(obj);
	if (t < 1 || t > 5)
	    t = 4;
	k = null;
	cm = .config("fight/item_value").measure.repair_cm;
	if (cm != null)
	    k = cm[t - 1];
	if (k == null) {
	    if (t == 1) k = 315;
	    else if (t == 2) k = 175;
	    else if (t == 3) k = 105;
	    else if (t == 4) k = 70;
	    else k = 35;
	}
	dmg = 100 - obj.condition;
	if (dmg < 0)
	    dmg = 0;
	var price; price = .max(100, .max(1, obj.level) * k * dmg / 100);
	// Precious metal costs a jeweler far more than iron costs a smith.
	if (obj.item_type == .tables.item_table.jewelry || obj.item_type == .tables.item_table.treasure) {
	    var mat; mat = obj.pIndexData.material;
	    if (mat == "gold" || mat == "silver" || mat == "platinum" || mat == "mithril")
		price = price * 3 / 2;
	}
	return price;
    };
    
    /////////////////////////////////////////////////////////////
    ////////////////////// MATERIALS ////////////////////////////
    /////////////////////////////////////////////////////////////
    
    // A quest target (stolen loot, kidnap mark...) is a borrowed world item
    // the quest cannot replace: losing it to fire or acid strands the quest.
    .tmp.object.indestructible = function(obj) {
	return (!.tmp.object.valid(obj)
		|| obj.extra_flags & .tables.extra_flags.nopurge
		|| obj.personal != null
		|| obj.cppBehavior == "ObjQuestTarget");
    };
	
    .tmp.object.isElastic = function(obj) {
	return (obj.material.cloth || obj.material.leather);
    };
    
    // Return material config structure by material name
    .tmp.object.getMaterialConfig = function(material_name) {
	var material; 
	var material_config; material_config = .config("fight/material");
	
	for (k in material_config.keys) {
	    if (material_config[k].name == material_name) {
		material = material_config[k];
		break;
	    }
	}
	return material;
    };
    
    // TO-DO (RUFFINA): This helper has been debugged for MONTHS -- lots of
    // breakpoints and debug messages, remove later when not needed anymore
    .tmp.object.materialHasFlag = function(obj, flag) {
	var material, materials, found; found = false; materials = .List();
	// sanity checks
	if (!.tmp.object.valid(obj)) return false; 
	if (flag == null || flag == "") {
	    .discord_wiznet(.fmt("[{WMATERIAL{x]: materialHasFlag called for %O1 {D[%d]{x with empty flag", obj, obj.vnum));
	    return false;
	}
	var mname; mname = obj.material.name;
	if (mname == null) {
	    obj.getRoom().echo(
		._("{r[{RБАГ{r]:{x {1%O1:{2 неправильная конфигурация материала, напиши Богам."), obj);
	    .discord_wiznet(.fmt("[{WMATERIAL{x]: %O1 {D[%d]{x -- incorrect material", obj, obj.vnum));
	    return false;
	}
	materials = mname.split(", ");
	if (materials.size() < 1) {
	    obj.getRoom().echo(
		._("{r[{RБАГ{r]:{x {1%O1:{2 неправильная конфигурация материала, напиши Богам."), obj);
	    .discord_wiznet(.fmt("[{WMATERIAL{x]: %O1 {D[%d]{x -- incorrect material", obj, obj.vnum));
	    return false;		    
	}
	
	for (m in materials) {
	    if (m == null) continue; // sanity check
	    var tmp; try { tmp = .Material(m); } catch(e) {.discord_wiznet(e);}
	    if (tmp == null) {
		obj.getRoom().echo(
		    ._("{r[{RБАГ{r]:{x {1%O1:{2 неправильная конфигурация материала, напиши Богам."), obj);
		.discord_wiznet(.fmt("[{WMATERIAL{x]: %O1 {D[%d]{x -- incorrect material", obj, obj.vnum));
		return false;			        
	    }
	    
	    material = .tmp.object.getMaterialConfig(m);
	    if (material == null) {
		obj.getRoom().echo(
		    ._("{r[{RБАГ{r]:{x {1%O1:{2 неправильная конфигурация для материала '{Y%s{x', напиши Богам."), obj, m);
		.discord_wiznet(.fmt("[{WMATERIAL{x]: %O1 {D[%d]{x -- no config for material '{Y%s{x'", obj, obj.vnum, m));
	    }
	    else if (material.flags != null && material.flags.contains(flag)) found = true;
	}
	
	return found;
    };
    
    /////////////////////////////////////////////////////////////
    ////////////////////// BASIC HELPERS ////////////////////////
    /////////////////////////////////////////////////////////////
    
    // Basic helper to check if the obj "exists". An object queued by
    // .tmp.system.trueExtract is already gone for gameplay purposes.
    .tmp.object.valid = function(obj) {
	return (obj != null && !obj.dead && obj.condition > 0 && obj.extractPending != true);
    };
    
    // Determine if object has a specific wearloc (from wear_loc_flags)
    // Use this instead of (obj.wear_flags & .tables.wear_flags.wear_xxx)
    // e.g. .tmp.object.hasWearloc(obj, "hooves")
    // Strip "_" to match any combinations of "neck_X" and "wrist_X"
    .tmp.object.hasWearloc = function(obj, name) {
	var found; found = false;
	for (w in obj.wearlocs)
	    if (w.name.split("_").front() == name.split("_").front()) 
		found = true;
	return found;
    };

    // Determine whether an item can be dropped
    // Use this instead of ch.can_drop_obj(obj) when there's no ch
    .tmp.object.canDrop = function(obj) {
	return (.tmp.object.valid(obj) &&
		!(obj.extra_flags & .tables.extra_flags.nodrop));
    };
    
    // Determine whether an item can be removed if worn
    .tmp.object.canRemove = function(obj) {
	return (.tmp.object.valid(obj) && obj.worn &&
		!(obj.extra_flags & .tables.extra_flags.noremove) &&
		!(obj.wear_flags & .tables.wear_flags.wear_tattoo));
    };
    
    // Determine if character has enough strength to kick/throw an object
    .tmp.object.movable = function(ch, obj) {
	return (.tmp.object.valid(obj) &&
		(obj.wear_flags & .tables.wear_flags.take) &&
		.tmp.weight.effectWeight(obj) <= 200 + .urange(-20, (ch.cur_str - 20) * 3, 20));
    };		
    
    // Create a .List() of worn items that can be removed.
    .tmp.object.removableEquip = function(ch) {
	var eq; eq = .List();
	for (item in ch.equipment) {
	    if (!.tmp.object.canRemove(obj)) continue;
	    eq.add(item);
	}
	return eq;
    };

    /////////////////////////////////////////////////////////////
    ////////////////////// WEAPONS //////////////////////////////
    /////////////////////////////////////////////////////////////
    
    // simple helper to check if the obj is weapon (shorter than checking flags)
    .tmp.object.isWeapon = function(obj) {
	return (.tmp.object.valid(obj) && 
		obj.item_type == .tables.item_table.weapon);
    };	
    
    // Return obj weapon class as a string. Reads the affected class, so a
    // weapon carrying a weapon_class override answers with what it fights as.
    .tmp.object.getWeaponClass = function(obj) {
	if (.tmp.object.isWeapon(obj))
	    return .tables.weapon_class.names(obj.weapon_class);
	else return "";
    };
    
    // Does this weapon have blade?
    .tmp.object.hasBlade = function(obj) {
	var class; class = .tmp.object.getWeaponClass(obj);
	return (class != "" &&
		( (obj.attack_damage == "pierce" || obj.attack_damage == "slash") ||
		  (class == "sword" || class == "dagger" || class == "axe" ||
		   class == "spear" || class == "polearm" || class == "arrow") ));
    };
    
    // Does this weapon have pole?
    .tmp.object.hasPole = function(obj) {
	var class; class = .tmp.object.getWeaponClass(obj);
	return (class != "" &&
		(class == "axe" || class == "spear" || class == "polearm" ||
		 class == "lance" || class == "arrow" || class == "staff"));
    };

    /////////////////////////////////////////////////////////////
    ////////////////// COST, SIZE, AC ///////////////////
    /////////////////////////////////////////////////////////////
	
    // What equipping multiplies an armor's values by. Mirrors <armorCoef> in
    // dreamland_world/wearlocations, which Fenia has no accessor for: best slot wins.
    .tmp.object.armorCoef = function(obj) {
	if (!.tmp.object.valid(obj)) return 1;
	var f, W; f = obj.wear_flags; W = .tables.wear_flags;
	if (f & W.wear_body) return 4;
	if (f & (W.wear_shield | W.wear_horse)) return 3;
	if (f & (W.wear_head | W.wear_arms | W.wear_legs)) return 2;
	return 1;
    };
	
    .tmp.object.getTrueAC = function(obj) {
	if (!.tmp.object.valid(obj)) return 0;
	var ac, armorCoef; ac = .Map();
	armorCoef = .tmp.object.armorCoef(obj);
	ac.value0 = 0; ac.value1 = 0; ac.value2 = 0; ac.value3 = 0;
	if (obj.item_type & .tables.item_table.armor) {
	    ac.value0 = obj.value0 * armorCoef;
	    ac.value1 = obj.value1 * armorCoef;
	    ac.value2 = obj.value2 * armorCoef;
	    ac.value3 = obj.value3 * armorCoef;
	} 
	return ac;
    };
    
    // Calculate cost based on level, tier and weight
    // Weight adds no more than 5-6 gold
    // cost = (10 silver * level) * (6 - tier) ^ 2 + weight
    // Example 1: tier 3, level 10 item  = 100  * 3^2 = 9 gold + weight
    // Example 2: tier 1, level 100 item = 1000 * 5^2 = 250 gold + weight
    // TO-DO: Add market material costs to fedit material
    .tmp.object.calculateCost = function(obj, tier) {
	if (!.tmp.object.valid(obj)) return 0;
	// cap at 300 gold
	return .min(10 * obj.level * (6 - tier) * (6 - tier) + obj.weight, 30000);
    };
    
    /////////////////////////////////////////////////////////////
    ////////////////////// MAGIC ////////////////////////////////
    /////////////////////////////////////////////////////////////
    
    // Chance to dispel object affects
    .tmp.object.savesDispel = function(dispel_level, affect_level, duration) {
	var save;
	// much harder to dispel permanent affects
	if (duration == -2) affect_level = affect_level + 10;
	// harder to dispel "native" mob affects
	if (duration == -1) affect_level = affect_level + 5;
	
	// each level diff adds/subtracts 5% chance to dispel
	save = 50 + (affect_level - dispel_level) * 5;
	save = .urange(5, save, 95);

	return .chance(save);
    };
    
    // Return level on which the item will auto-cast in onFight.
    .tmp.object.castLevel = function(obj) {
	if (!.tmp.object.valid(obj)) return 1;
	var ch; ch = obj.carried_by;
	if (ch.is_npc()) return obj.level;
	else return ch.modifyLevel;
    };
    
    /////////////////////////////////////////////////////////////
    ////////////////////// OTHER ////////////////////////////////
    /////////////////////////////////////////////////////////////
    
    // Build a puddle object of any liquid, not attached to any room yet.
    // Callers that need the puddle to land somewhere the normal way should use
    // create_puddle; this one is for places that must bypass its room checks,
    // e.g. an affect handler that runs while the room still reads as water.
    .tmp.object.make_puddle = function(liquid, amount, poisoned) {
	if (amount == null) amount = 50; // default
	var liq;
	try {liq = .Liquid(liquid);} catch (e);
	if (liq == null) return null;

	var puddle; puddle = .get_obj_index(75).create();
	.tmp.object.namePuddle(puddle, liq);
	puddle.timer = .tmp.object.puddleTimer(amount);
	puddle.value0 = .max(1, amount);
	puddle.value1 = .max(1, amount);
	puddle.value2 = liq.index;

	// A poisoned drink poured out leaves a poisoned puddle -- otherwise filling a
	// bottle from it (or drinking it) launders the poison away (Trello: puddle washes
	// poison). The marker is a "poison" AFFECT, NOT the value3 drink-flag: the puddle is
	// a fountain (vnum 75) whose value3 is its max-people count (Item::furnitureMaxPeople),
	// never read as poison by drink/fill, so a value3 stamp would be a fake fix. The Fenia
	// drink and fill overrides read isAffected("poison") off the source. Mirrors the
	// fountain-poison precedent (midgaard obj 3135 q5379). Level 0 on purpose: the drink
	// override reads a positive poison level as the poisoner's dose, while 0 falls back to
	// a sip-sized dose -- a puddle does not remember who poisoned the drink.
	if (poisoned == true) {
	    var af; af = .Affect();
	    af.type = "poison";
	    af.duration = puddle.timer;
	    af.level = 0;
	    puddle.affectJoin(af);
	}

	return puddle;
    };

    // Create a puddle of any liquid, silently: the caller prints its own
    // flavour (death cry blood, a flooded desert, a cuisinart burst).
    .tmp.object.create_puddle = function(liquid, room, amount, poisoned) {
	.tmp.object.spill_puddle(liquid, room, amount, poisoned, false);
    };

    // Create a rain puddle of water (separate, faster implementation)
    .tmp.object.create_rain_puddle = function(room) {
	if (room == null) return;
	var liq; liq = .Liquid("water");
	
	// TO-DO (RUFFINA): Temporarily change room liquid instead
	if (room.isWater()) {
	    room.echo(._("Капли дождя разводят круги на %1$N6."),
		.mm(room.liquid.getShort(0), room.liquid.getShort(1), room.liquid.getShort(2)));
	    return;
	}
	
	var puddle; puddle = .get_obj_index(75).create();
	// The prototype (vnum 75) ships "%s" placeholders. short_descr and
	// description are RU-only setters, so EN and UA must be filled explicitly
	// or the raw template leaks into the decay message.
	puddle.short_descr = "луж|а|и|е|у|ей|е воды";
	puddle.setShort("puddle of water", 0);
	puddle.setShort("калюж|а|і|і|у|ею|і води", 2);
	puddle.description = "{xДождевая лужа хлюпает под ногами.";
	puddle.setDescr("{xA rain puddle squelches underfoot.", 0);
	puddle.setDescr("{xДощова калюжа хлюпає під ногами.", 2);
	puddle.name = "puddle water дождевая лужа воды";
	puddle.timer = .number_range(1, 3);
	puddle.value2 = liq.index;
	puddle.obj_to_room(room);
    };

    // Kept at the end of the file on purpose: a re-post recompiles functions by
    // parse ordinal, so new functions go after the existing ones.

    // Ticks a puddle of this volume lasts (C++ create_pool): amount/15, at
    // least 2, and 1 for a trickle under 15.
    .tmp.object.puddleTimer = function(amount) {
	var t; t = amount / 15;
	if (t <= 0) return 1;
	return .max(2, t);
    };

    // Name a puddle after its liquid in all three languages, so %O nouns
    // (act/decay/look) localize per viewer. The prototype (vnum 75) ships "%s"
    // placeholders; this fills them. Rerun when a merge turns the puddle into
    // swill.
    .tmp.object.namePuddle = function(puddle, liq) {
	puddle.short_descr = "луж|а|и|е|у|ей|е " + liq.short_descr.ruscase(2);
	puddle.setShort("puddle of " + liq.getShort(0), 0);
	puddle.setShort("калюж|а|і|і|у|ею|і " + liq.getShort(2).ruscase(2), 2);
	puddle.description = "{xЛужа " + liq.short_descr.ruscase(2) + " разлита тут.";
	puddle.setDescr("{xA puddle of " + liq.getShort(0) + " is spilled here.", 0);
	puddle.setDescr("{xКалюжа " + liq.getShort(2).ruscase(2) + " розлита тут.", 2);
	puddle.name = "puddle pool лужа калюжа " + liq.name + " " + liq.short_descr.ruscase(2).stripColour();
    };

    // Puddle with the C++ create_pool rules (drink_commands.cpp): a puddle
    // landing where one already lies merges into it, two different liquids mix
    // into swill, and the timer grows with the poured volume. verbose prints
    // the formation / spread / mix line, which the pour command shows.
    // Fire and heat react to the poured liquid before it merges.
    // Spilled in open air, the liquid lands in the room puddleLanding picks,
    // silently: callers that announce the fall do it themselves.
    .tmp.object.spill_puddle = function(liquid, room, amount, poisoned, verbose) {
	if (amount == null) amount = 50; // default
	if (room == null) return;
	var liq;
	try {liq = .Liquid(liquid);} catch (e);
	if (liq == null) return;
	room = .tmp.object.puddleLanding(room);
	if (room == null) return; // nothing below the open air: the liquid is lost
	// short_descr is RU only, .mm resolves the liquid name per viewer language.
	var liqName; liqName = .mm(liq.getShort(0), liq.getShort(1), liq.getShort(2));

	// TO-DO (RUFFINA): Temporarily change room liquid instead
	if (room.isWater()) {
	    room.echo(._("%1$^N1 постепенно перемешивается с %2$N5 в этой местности и исчезает."),
		liqName, .mm(room.liquid.getShort(0), room.liquid.getShort(1), room.liquid.getShort(2)));
	    return;
	}

	var puddle; puddle = .tmp.object.make_puddle(liquid, amount, poisoned);
	if (puddle == null) return;
	// obj_to_room, not dropObj: the landing room is already resolved, and
	// dropObj's air fall would start from the Fenia storage room that
	// create() parks a new object in, not from this room.
	puddle.obj_to_room(room);

	var fire; fire = room.get_obj_vnum(39001);
	
	if (fire != null) {
	    if (liq.isBooze()) { // Alcohol feeds fire
		room.echo(._("%1$^O1 воспламеня%1$nется|ются от %2$O2!"), puddle, fire);
		fire.fire_time = fire.fire_time + .max(1, amount / 50);
		fire.timer = fire.timer + .max(1, amount / 50) + 1;
		puddle.extract(true);
		return;
	    }  
	    
	    // Not alcohol? Let's try to extinguish the fire
	    if (fire.fire_time > 1 && amount / 10 < fire.fire_time) {
		room.echo(._("%1$^N1 немного притушивает %2$O4."), liqName, fire);
		fire.fire_time = fire.fire_time - 1;
	    }
	    else .tmp.object.extinguish(fire, false); // no ashes
	}

	if (room.isAffected("heat")) {
	     var aff; aff = .Affect();
	    for (a in room.affected) 
		if (a.type == "heat") aff = a;
		
	    if (liq.isBooze()) { // Alcohol flares up in the surrounding heat
		room.echo(._("%1$^O1 воспламеня%1$nется|ются от бушующего вокруг пламени!"), puddle);
		// A heat *affect* need not have a physical fire object (vnum 39001);
		// only feed one if it's actually present, else this derefs null.
		if (fire != null) {
		    fire.fire_time = fire.fire_time + .max(1, amount / 50);
		    fire.timer = fire.timer + .max(1, amount / 50) + 1;
		}
		puddle.extract(true);
		return;
	    }
	    
	    // Not alcohol? Let's try to extinguish the fire
	    if (aff == null || .tmp.room.savesDispel(aff, amount, null)) {
		room.echo(._("%1$^N1 шипит и испаряется в бушующем вокруг пламени."), liqName);
		puddle.extract(true);
		return;
	    }
	    else if (aff.duration > .max(1, amount / 100)) {
		room.echo(._("%1$^N1 немного притушивает бушующее в этой местности пламя."), liqName);
		aff.duration = .max(1, aff.duration - 1);
		room.affectReplace(aff);
	    }
	    else room.affectStrip(aff.type, true);
	}

	// Merge into a puddle already lying here. obj_to_room put the new one at
	// the head of the room, so look for any other vnum 75.
	var pool; pool = null;
	for (o in room.items) {
	    if (o.vnum == 75 && o != puddle) {
		pool = o;
		break;
	    }
	}

	if (pool == null) {
	    if (verbose)
		room.echo(._("На земле образуется лужа %1$N2."), liqName);
	    return;
	}

	var total; total = pool.value1 + puddle.value1;
	if (pool.value2 != liq.index) {
	    // Two liquids mix into swill.
	    var pooled; pooled = .Liquid(pool.value2);
	    var swill; swill = .Liquid("swill");
	    if (verbose)
		room.echo(._("%1$^N1 и %2$N1 смешиваются, образуя лужу %3$N2."),
		    liqName,
		    .mm(pooled.getShort(0), pooled.getShort(1), pooled.getShort(2)),
		    .mm(swill.getShort(0), swill.getShort(1), swill.getShort(2)));
	    .tmp.object.namePuddle(pool, swill);
	    pool.value2 = swill.index;
	}
	else if (verbose)
	    room.echo(._("Лужа %1$N2 растекается еще шире."), liqName);

	// A puddle can't be broader than its contents. A builder-placed puddle
	// with no timer stays permanent.
	pool.value0 = .max(1, total);
	pool.value1 = .max(1, total);
	if (pool.timer > 0)
	    pool.timer = pool.timer + .tmp.object.puddleTimer(amount);

	// Poison from either side keeps the whole pool poisoned for its lifetime.
	if (puddle.isAffected("poison") || pool.isAffected("poison")) {
	    pool.affectStrip("poison");
	    var paf; paf = .Affect();
	    paf.type = "poison";
	    paf.duration = .max(1, pool.timer);
	    paf.level = 0;
	    pool.affectJoin(paf);
	}

	puddle.extract(true);
	room.saveItems();
    };

    // Where a liquid spilled in this room comes to rest. A liquid can't hang
    // in open air: it runs down the open down exits to the first room that
    // is not air (water too -- spill_puddle mixes it in there). Off a fall
    // trap (rope bridge, ledge) it goes where the trap drops a falling
    // character, like a dropped object (trapTarget). A closed hatch below or
    // a mansion floor holds it (mansion floors never drop anything, as in
    // dropObj). When the down exits run out in open air (a dead end, a
    // down-exit cycle, more than 20 rooms) it lands where a falling
    // character would (stuckLanding). Returns null when even that finds no
    // ground or water: the liquid is lost.
    .tmp.object.puddleLanding = function(room) {
	if (room == null) return null;
	var i, dir, next, start;
	start = room;
	dir = room.doorNumber("down");
	for (i = 0; i < 20; i = i + 1) {
	    if (room.room_flags & .tables.room_flags.mansion)
		return room;
	    if (room.sector_type != .tables.sector_table.air) {
		if (room.isWater())
		    return room;
		next = .tmp.object.trapTarget(room);
		if (next == null) return room;
	    } else {
		next = room.getRoom(dir);
		if (next == null || next == room)
		    return .tmp.object.stuckLanding(room, start);
		if (room.getExitFlags(dir) & .tables.exit_flags.closed) return room;
	    }
	    room = next;
	}
	return .tmp.object.stuckLanding(room, start);
    };

    // The room a fall trap in this room (props.trap: rope bridge, ledge,
    // shaft) drops things into: the same room a falling character lands in,
    // see .tmp.trap.work. Null when there is no trap, the target is 0 (a
    // fatal plunge with no landing) or no such room, and when the trap would
    // carry a thing up out of water into open air (trap.work holds an
    // unwinged faller under water the same way).
    .tmp.object.trapTarget = function(room) {
	if (room == null || room.props == null) return null;
	var trap; trap = room.props.trap;
	if (trap == null || trap.target == null || trap.target <= 0) return null;
	var to; to = .get_room_index(trap.target);
	if (to == null || to == room) return null;
	if (room.isWater() && to.sector_type == .tables.sector_table.air)
	    return null;
	return to;
    };

    // Where a thing dropped in a fall-trap room comes to rest: the trap's
    // target, followed on through further trap rooms (the hut shaft 802-806
    // is a chain), so a dropped thing and a falling character end up in the
    // same room. Stops in an open-air room or on a mansion floor, and after
    // 20 rooms. Null when this room's trap has no landing (trapTarget).
    .tmp.object.trapLanding = function(room) {
	var i, next;
	next = .tmp.object.trapTarget(room);
	if (next == null) return null;
	for (i = 0; i < 20; i = i + 1) {
	    room = next;
	    if (room.sector_type == .tables.sector_table.air
		|| (room.room_flags & .tables.room_flags.mansion))
		return room;
	    next = .tmp.object.trapTarget(room);
	    if (next == null) return room;
	}
	return room;
    };

    // Where a fall through open air ends when the down exits run out before
    // solid ground (a dead end, a down-exit cycle like the isles maze, more
    // than 20 rooms): where a falling character would land. The trap of the
    // room the fall got stuck in comes first -- it is the lowest point
    // reached, and a character falling from there lands at its target --
    // then the trap of the room the fall started from. Only ground or water
    // counts (a target in open air would just hang there again). Null when
    // neither trap gives one: the caller keeps its own dead-end rule.
    .tmp.object.stuckLanding = function(stuck, start) {
	var to; to = .tmp.object.trapLanding(stuck);
	if (to != null && to.sector_type != .tables.sector_table.air)
	    return to;
	to = .tmp.object.trapLanding(start);
	if (to != null && to.sector_type != .tables.sector_table.air)
	    return to;
	return null;
    };
})
