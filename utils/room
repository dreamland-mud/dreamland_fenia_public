.apply(function() {
    
    if (.tmp.room == null) .tmp.room = .Map();

    ////////////////////////////////////////////////////////////////////////
    //////////////////////  BURN/FLOOD ROOMS  //////////////////////////////
    ////////////////////////////////////////////////////////////////////////
    
    // Check if it's possible to start a fire (heat) in a room
    .tmp.room.canBurn = function(room) {
	if (.tmp.transport.isProtectedRoom(room)) return false; 
	
	if (room.sector_type == .tables.sector_table.air
	    || room.sector_type == .tables.sector_table.underwater
	    || room.sector_type == .tables.sector_table.water_swim
	    || room.sector_type == .tables.sector_table.water_noswim)
	    return false; // no fire if water or air
	    
	if (room.isOutside() && !room.isAffected("heat") &&
	    (room.sector_type == .tables.sector_table.desert
	     || room.sector_type == .tables.sector_table.field))
	     return false; // no fire when wide open
	
	return true;
    };
	
    .tmp.room.burn = function(room, level, duration) {
	if (room == null || !.tmp.room.canBurn(room)) return;
	if (room.isAffected("heat")) return;
	
	if (!room.isOutside())
	    room.echo(._("{RВ замкнутом пространстве вокруг тебя начинается пожар! Беги!{x"));
	else if (room.sector_type == .tables.sector_table.forest) 
	    room.echo(._("{RДеревья вокруг тебя внезапно охватывает гудящее пламя -- начинается пожар!{x"));
	else if (room.sector_type == .tables.sector_table.city)    
	    room.echo(._("{RУлицы и дома вокруг занимаются огнем -- начинается пожар!{x"));
	else room.echo(._("{RВся окружающая местность вспыхивает -- начинается пожар!{x"));

	if (room.isAffected("deforestation"))
	    room.affectStrip("deforestation", false);
	
	var af; af = .Affect();
	af.type      = "heat";
	af.level     = level;
	af.duration  = duration;
	af.bitvector("room_flags", "no_quest");
	af.location  = .tables.apply_flags.sector_type;
	af.modifier  = .tables.sector_table.desert;
	
	// TO-DO (RUFFINA): Replace this with room instances interface
	room.original_sector_type = room.fire_msg = null;
	room.original_sector_type = room.sector_type;
	
	// Saving future affect description into af.global in lieu of af.fenia_vars
	if (!room.isOutside())
	    room.fire_msg = "{1{RПОЖАР!{2 Замкнутое пространство вокруг {1{Yраскалено и затянуто дымом{2";
	else if (room.sector_type == .tables.sector_table.forest) 
	    room.fire_msg = "{1{RПОЖАР!{2 Деревья вокруг тебя {1{Yпылают,{2 живность в ужасе разбегается";
	else if (room.sector_type == .tables.sector_table.hills) 
	    room.fire_msg = "{1{RПОЖАР!{2 Склоны холмов {1{Yпылают и затянуты дымом,{2 воздух раскален";
	else if (room.sector_type == .tables.sector_table.city)  
	    room.fire_msg = "{1{RПОЖАР!{2 Улицы и дома {1{Yпылают,{2 люди в ужасе разбегаются";	
	else room.fire_msg = "{1Все вокруг {1{Yпылает{2, воздух раскален";
	
	room.affectAdd(af);
	
	if (room.room_flags & .tables.room_flags.near_water) {
	    af.bitvector("room_flags", "near_water");
	    af.location = .tables.apply_flags.bitvector;
	    af.modifier = -1; // remove near_water flag
	    room.affectAdd(af);
	}

    };
    
    // Attempt to extinguish heat affect and any fires in a room
    // ch can be null. use level -1 for guaranteed action
    .tmp.room.extinguish = function(room, level, ch) {
	if (room == null) return;
	if (level == null) level = 50; // default
	if (room.isAffected("heat")) {
	    var aff; aff = .Affect();
	    for (a in room.affected) 
		if (a.type == "heat" && a.duration != -1) aff = a;	
	    if (level == -1 || !.tmp.room.savesDispel(aff, level, ch))
		room.affectStrip(aff.type, true);
	}
	var fire; fire = room.get_obj_vnum(39001);
	if (fire != null) .tmp.object.extinguish(fire, false); // no ashes 
    };

    // Source can be null for room behavior.
    .tmp.room.flood = function(room, level, duration, sector, source) {
	if (room == null || room.isAffected("flood")) return;
	
	if (room.isAffected("cultivate")) // flood strips terraforming
	    room.affectStrip("cultivate", true);

	// flood extinguishes non-permanent heat/fire
	.tmp.room.extinguish(room, level, source);

	// TO-DO (RUFFINA): Replace this with room instances interface
	// onRemoveRoom runs before the sector override is lifted, so it cannot read
	// the pre-flood terrain off the room. Only temporary floods ever recede.
	// Set after extinguish: stripping heat annuls this same field.
	if (duration != -1) room.original_sector_type = room.sector_type;

	var af; af = .Affect();
	af.type      = "flood";
	af.level     = level;
	af.duration  = duration;
	af.location = .tables.apply_flags.sector_type;
	af.modifier = sector; 
	if (source != null) af.source = source;
	af.bitvector("room_flags", "no_quest near_water");
	room.affectAdd(af);	

	af.location = .tables.apply_flags.none;	
	af.modifier = 0;
	af.bitvector("raffect_flags", "prevent"); // protected from "progress"
	room.affectAdd(af);

	af.where = .tables.affwhere_flags.liquids;
	af.global = "water";
	room.affectAdd(af);

    };

    ////////////////////////////////////////////////////////////////////////
    //////////////////////  FORESTS / TREES  ///////////////////////////////
    ////////////////////////////////////////////////////////////////////////

    // Drop a log or firewood in a room: lumberjack, hurricane etc.
    // Picks a wood material weighted by rarity; softwoods common, hardwoods rare.
    .tmp.room.dropTree = function(room) {
	var product;
	if (.chance(1)) {
	    product = .get_obj_index(28036).create(); // firewood (rotten tree)
	    room.echo(._("Сгнившее дерево падает %1$s, превращаясь в %2$O4!"),
		.tmp.room.dropWhere(room), product);
	}
	else {
	    // Parallel lists: base vnum (hardness tier), material name, Russian adjective, weight.
	    // Empty adj means keep stock short_descr. Softwoods (28037) common, hardwoods (28038) rare.
	    var vnums, materials, adjs, weights;
	    vnums     = .List().add(28037, 28037, 28037, 28037, 28037,  28038, 28038, 28038, 28038);
	    materials = .List().add("aspen", "yew", "redwood", "bamboo", "softwood",
				    "oak", "ashwood", "hardwood", "ebony");
	    adjs      = .List().add("осинов|ое|ого|ому|ое|ым|ом",
				    "тисов|ое|ого|ому|ое|ым|ом",
				    "", // redwood uses a genitive phrase, not adjective
				    "бамбуков|ое|ого|ому|ое|ым|ом",
				    "", // softwood: keep stock short_descr
				    "дубов|ое|ого|ому|ое|ым|ом",
				    "ясенев|ое|ого|ому|ое|ым|ом",
				    "", // hardwood: keep stock "бревно из твердого дерева"
				    "эбенов|ое|ого|ому|ое|ым|ом");
	    weights   = .List().add(25, 18, 15, 12, 10,  10, 6, 3, 1); // total 100

	    // Weighted random pick
	    var total, roll, idx; total = 0; idx = 0;
	    for (w in weights) total = total + w;
	    roll = .number_range(1, total);
	    
	    for (w in weights) {
		if (roll <= w) break;
		roll = roll - w;
		idx = idx + 1;
	    }

	    product = .get_obj_index(vnums.at(idx)).create();
	    product.material = .Material(materials.at(idx));

	    // Rename based on picked material
	    var adj; adj = adjs.at(idx);
	    if (materials.at(idx) == "redwood") {
		product.short_descr = "бревн|о|а|у|о|ом|е из красного дерева";
		product.keyword = "log redwood бревно красное дерево";
	    }
	    else if (adj != "") {
		var parts; parts = adj.split("|");
		product.short_descr = adj + " бревн|о|а|у|о|ом|е";
		product.keyword = "log " + materials.at(idx) + " бревно "
		    + parts.at(0) + " " + parts.at(0) + parts.at(1);
	    }
	    // Softwood/hardwood generic: keep stock short_descr & keyword.

	    room.echo(._("Дерево с грохотом падает %1$s, превращаясь в %2$O4!"),
		.tmp.room.dropWhere(room), product);
	}

	product.timer = .tmp.time.months(1); // timer to prevent hoarding
	.tmp.object.dropObj(null, product, false, room); // drop the log
    };

    // Returns the number of healthy trees, damaged trees and young sprouts in a forest
    .tmp.room.getTreeStats = function(room) {	
	if (room.sector_type != .tables.sector_table.forest && 
	    !room.isAffected("deforestation")) return null; // sanity check
	var stats; stats = .Map(); // assign defaults
	stats.forest_total = 500;
	stats.healthy_trees = 500;
	stats.damaged_tree = 0;
	stats.sprouts = 0;
	
	if (room.isAffected("deforestation")) {
	    for (af in room.affected) {
		if (af.type == "deforestation") {
		    if (af.location == .tables.apply_flags.hit && af.modifier >= 0)
			stats.forest_total = af.modifier;
		    else if (af.location == .tables.apply_flags.mana & af.modifier >= 0)
			stats.sprouts = af.modifier;
		}
	    }
	    stats.damaged_tree = stats.forest_total % 100;
	    stats.healthy_trees = stats.forest_total - stats.damaged_tree;
	}
	
	return stats;
    };
    
    // Apply or update deforestation affect with tree stats
    .tmp.room.updateForest = function(room, level, stats) {
	room.affectStrip("deforestation", false);
	
	var af; af = .Affect();
	af.type      = "deforestation";
	af.level     = level;
	af.duration  = -1;

	if (stats.forest_total <= 0) {
	    for (vch in room.ppl) // nowhere left to hide
		if (vch.isAffected("camouflage")) vch.visible();

	    af.location  = .tables.apply_flags.sector_type;
	    af.modifier  = .tables.sector_table.field;
	    room.affectAdd(af);
	}

	af.location  = .tables.apply_flags.hit;
	af.modifier  = .max(0, stats.healthy_trees + stats.damaged_tree);
	room.affectAdd(af);
	
	af.location  = .tables.apply_flags.mana;
	af.modifier  = .max(0, stats.sprouts);
	room.affectAdd(af);
	
	return true;
    };

    ////////////////////////////////////////////////////////////////////////
    ////////////////////////  VARIOUS HELPERS  /////////////////////////////
    ////////////////////////////////////////////////////////////////////////
    
    // "Smart" echo in the room: accounts for blindness, sleep etc.
    .tmp.room.echo = function(room, msg) {
	if (room == null) return;
	
	for (rch in room.players) {
	    if (.tmp.mob.awake(rch) && !.tmp.mob.isBlind(rch))
		rch.act(msg);
	}
    };

    // Localizable "onto the ground" phrase for the room's sector. Wrapped in
    // ._() so room-echo/act %s args resolve per viewer (Trello 2594). Callers
    // that build strings eagerly with .fmt must use dropWhereRaw() instead.
    .tmp.room.dropWhere = function(room) {
	return ._(.tmp.room.dropWhereRaw(room));
    };

    // Raw RU location string picked by sector_type, for eager .fmt-built messages.
    .tmp.room.dropWhereRaw = function(room) {
	var msg; msg = "на землю";
	if (room != null) {
		var sect; sect = room.sector_type;
		// the intro galleon reads as city-sector, but it's a wooden ship --
		// a dropped or landed missile ends up on its deck, not "on the pavement"
		if (room.area != null && room.area.filename == "galeon.are")
			msg = "на палубу";
		else if (room.isWater())
			msg = "в воду";
		else if (sect == .tables.sector_table.city) {
			if (!room.isOutside()) msg = "на пол";
			else msg = .List().add("на дорогу", "на мостовую", "на брусчатку").random();
		}
		else if (sect == .tables.sector_table.inside) msg = "на пол";
		else if (sect == .tables.sector_table.hills)
			msg = .List().add("в траву", "на склон холма", "на поросшую травой землю").random();
		else if (sect == .tables.sector_table.field)
			msg = .List().add("в луговую траву", "в цветы и траву", "на поросшую травой землю").random();
		else if (sect == .tables.sector_table.forest)
			msg = .List().add("в траву", "в лесной мох", "на влажную лесную землю").random();
		else if (sect == .tables.sector_table.mountain)
			msg = .List().add("на камни", "на сухую горную землю").random();
		else if (sect == .tables.sector_table.desert)
			msg = .List().add("в песок", "на потрескавшуюся от засухи землю").random();
		else if (sect == .tables.sector_table.air) msg = "в воздух";
	}
	return msg;
    };

    // Determine if room has puddles of liquid: harder to dirt, louder to sneak by
    .tmp.room.hasPuddles = function(room) {
	if (room == null) return false;
	var puddle; puddle = room.get_obj_vnum(75);
    
	return (room.isWater() || puddle != null);
    };
    
    // Is room part of onboarding?
    .tmp.room.isIntroArea = function(room) {
	return .tmp.transport.isIntroArea(room.area);
    };
    
    // Chance to dispel room affects. ch can be null
    // Returns TRUE if saves vs. dispel --> dispel DOESN'T WORK
    // Returns FALSE if save fails --> dispel works
    .tmp.room.savesDispel = function(affect, dispel_level, ch) {
	if (affect == null) return true; // sanity check
	if (affect.duration < 0) return true; // can't dispel permanent affects

	var save;
	// each level diff adds/subtracts 5% chance to dispel
	save = 50 + (affect.level - dispel_level) * 5;
	save = .urange(5, save, 95);
	
	if (ch != null) return .tmp.chance(100 - save, ch);
	else return .chance(save);
    };
    
    .tmp.room.get_obj_behavior = function(room, bhv) {
	for (i in room.items)
	    if (i.hasBehavior(bhv))
		return i;
		
	return null;
    };	

    ////////////////////////////////////////////////////////////////////////
    ///////////  ENVIRONMENT + AREA ELEMENTAL EFFECTS  /////////////////////
    ////////////////////////////////////////////////////////////////////////

    // What the surroundings do to an elemental effect: an integer power delta
    // clamped to -3..+3, or -100 for "this room kills the effect outright".
    // Applied exactly once, at the entry of every .tmp.mob.effectX and every
    // .tmp.room.effectX.
    //
    // The direction is always what the room does to the SOURCE, never to the
    // victim: rain quenches a flame, standing water carries a discharge, a
    // desert at noon fights frostbite. The finer weather maths inside
    // heat_chance and freeze_chance stays where it is -- that serves the direct
    // applyHeat/applyCold callers (torches, forges, smithing) which never come
    // through here. Fire in the rain is therefore damped twice, on purpose.
    .tmp.room.elementMod = function(room, element) {
	if (room == null) return 0;

	var hot; hot = room.isAffected("heat");
	var flooded; flooded = room.isAffected("flood");

	// .tmp.room.burn overrides sector_type to DESERT through the heat affect
	// (see burn() above), so a burning room reads as a desert here and would
	// collect the desert row on top of the heat row: fire self-feeding +3
	// instead of +2, and cold beaten down -4 instead of -2 -- which is
	// exactly the case an ice spell exists for. The real terrain is stashed
	// in original_sector_type before the affect goes on. Flood's water
	// override is left alone: a flooded room really is standing water, and
	// the spec counts the sector and the affect as separate rows.
	var sect; sect = room.sector_type;
	if (hot && room.original_sector_type != null)
	    sect = room.original_sector_type;

	var outside; outside = room.isOutside();
	var underwater; underwater = (sect == .tables.sector_table.underwater);
	var water; water = (sect == .tables.sector_table.water_swim
			    || sect == .tables.sector_table.water_noswim
			    || .tmp.room.hasPuddles(room));
	var rain; rain = (outside && .sky == 2);
	var storm; storm = (outside && .sky == 3);
	var desert; desert = (sect == .tables.sector_table.desert);
	var air; air = (sect == .tables.sector_table.air);
	var indoors; indoors = (!outside || sect == .tables.sector_table.inside);
	var mod; mod = 0;

	if (element == "fire") {
	    if (underwater) return -100; // nothing burns down there
	    if (water) mod = mod - 2;
	    if (rain || storm) mod = mod - 2;
	    if (flooded) mod = mod - 2;
	    if (.season == "winter") mod = mod - 1;
	    if (.season == "summer" && outside && .sunlight > 0) mod = mod + 1;
	    if (desert && .sunlight > 0) mod = mod + 1;
	    if (hot) mod = mod + 2;
	}
	else if (element == "cold") {
	    // Wet gear and water carry heat away far faster than air does.
	    // These are separate rows in the spec table and stack: a flooded
	    // room in a storm is worse than either on its own.
	    if (underwater) mod = mod + 1;
	    else if (water) mod = mod + 1;
	    if (storm) mod = mod + 1;
	    if (flooded) mod = mod + 1;
	    if (.season == "winter") mod = mod + 2;
	    if (.season == "summer" && outside && .sunlight > 0) mod = mod - 1;
	    if (desert) {
		if (.sunlight > 0) mod = mod - 2; // noon in the sand
		else mod = mod + 1;               // desert nights bite
	    }
	    if (hot) mod = mod - 2;
	}
	else if (element == "shock") {
	    // Water conducts -- this is the headline case
	    if (underwater) mod = mod + 3;
	    else if (water) mod = mod + 2;
	    if (flooded) mod = mod + 2;
	    if (storm) mod = mod + 2; // charge already in the air
	    else if (rain) mod = mod + 1;
	    if (desert) mod = mod - 1; // bone-dry air insulates
	}
	else if (element == "acid") {
	    // Dilution is the whole story
	    if (underwater) mod = mod - 3;
	    else if (water) mod = mod - 2;
	    if (flooded) mod = mod - 2;
	    if (rain || storm) mod = mod - 2;
	    if (desert && .sunlight > 0) mod = mod + 1;
	    if (hot) mod = mod + 1;
	}
	else if (element == "poison") {
	    // Gas model: wind and rain scatter the cloud, closed rooms hold it
	    if (underwater) mod = mod - 2;
	    else if (water) mod = mod - 1;
	    if (flooded) mod = mod - 1;
	    if (storm) mod = mod - 2;
	    else if (rain) mod = mod - 1;
	    if (air) mod = mod - 2;
	    if (indoors) mod = mod + 1;
	}
	else if (element == "sand") {
	    // Needs loose dry particulate, and wet sand is just mud
	    if (underwater || water || flooded) return -100;
	    if (desert) mod = mod + 2;
	    if (rain) mod = mod - 1;
	    if (storm) mod = mod + 1;
	    if (air) mod = mod + 1;
	    if (indoors) mod = mod - 2; // only what the caster brought with them
	}
	else if (element == "scream") {
	    // Water carries sound much further, thin air bleeds the pressure
	    if (underwater) mod = mod + 2;
	    else if (water) mod = mod + 1;
	    if (flooded) mod = mod + 1;
	    if (indoors) mod = mod + 1; // reverberation
	    if (air) mod = mod - 1;
	}

	return .urange(-3, mod, 3);
    };

    // AREA entry for fire. The contact entry (.tmp.mob.effectFire) reaches the
    // victim and what the victim carries and nothing else, so a flaming sword
    // can never set the innkeeper's furniture alight; dragon breath, firestorms
    // and burning rooms come through here and still can.
    //
    // source_ch is the caster where there is one, null for room affects and
    // ambient heat. It is NOT forwarded to applyHeat: passing a source there
    // means "deliberately heating my own stuff" and jumps the chance to ~90%.
    .tmp.room.effectFire = function(room, source_ch, power) {
	if (room == null) return;
	power = .urange(0, power + .tmp.room.elementMod(room, "fire"), 10);
	if (power == 0) return;

	for (obj in room.items) {
	    if (!.tmp.object.valid(obj)) continue;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    .tmp.object.applyHeat(obj, null, null, power, false);
	}

	// The room itself only catches from a real blaze, never from a stray proc
	var room_temperature; room_temperature = power;
	var fire; fire = room.get_obj_vnum(39001);
	if (fire != null) room_temperature = room_temperature + .max(4, fire.fire_time / 4);

	if (.chance(room_temperature)) {
	    .tmp.object.createFire(room, null, power);
	    if (room_temperature >= 10 && .tmp.room.canBurn(room))
		.tmp.room.burn(room, power * 10 + 1, power / 2 + 1);
	}
    };

    // AREA entry for cold: floor items freeze, puddles and fountains ice over
    // (they are item_type fountain, so applyCold handles them), and a deep
    // enough freeze puts out whatever is burning here.
    .tmp.room.effectCold = function(room, source_ch, power) {
	if (room == null) return;

	// The quench is decided on the power the CALLER asked for, before the
	// room gets a say, and deliberately so: a burning room is the one thing
	// an ice spell is aimed at, and the heat row costs cold 2 power. Gating
	// this on the modulated value would mean iceball and white dragon breath
	// can never put out the fire they were cast into. Freezing the floor
	// items below still goes through the modulated power.
	if (power >= 8) .tmp.room.extinguish(room, power * 10, source_ch);

	power = .urange(0, power + .tmp.room.elementMod(room, "cold"), 10);
	if (power == 0) return;

	for (obj in room.items) {
	    if (!.tmp.object.valid(obj)) continue;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    .tmp.object.applyCold(obj, null, power, false);
	}
    };

    // AREA entry for shock: floor conductors take the discharge. Nothing
    // catches fire and there is no room affect for charged air, so the water
    // bonus in elementMod is the whole of the "arcs through the puddle" story.
    .tmp.room.effectShock = function(room, source_ch, power) {
	if (room == null) return;
	power = .urange(0, power + .tmp.room.elementMod(room, "shock"), 10);
	if (power == 0) return;

	for (obj in room.items) {
	    if (!.tmp.object.valid(obj)) continue;
	    if (obj.in_obj != null) continue; // ignore items inside containers
	    .tmp.object.applyShock(obj, null, power, false);
	}
    };
})