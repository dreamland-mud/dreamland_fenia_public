.apply(function() {
    if (.tmp == null) 
	.tmp = .Map();

    if (.tmp.system == null) 
	.tmp.system = .Map();
    
    this = .tmp.system;

    sleep = function (t) {
	var i;

	for (i = 0; i < t; i = i + 1)
	    .scheduler.yield();
    };

    // Sleep `t` ticks, then re-validate `ch`. Returns true if the caller
    // should keep going, false if `ch` is no longer reachable (extracted,
    // disconnected, etc.) and the caller should `return` immediately.
    //
    // Designed for cinematics, quest scripts, and rituals where each stage
    // is meaningless once the player has dropped. Replaces the inline
    //   .tmp.system.sleep(N);
    //   if (!.tmp.mob.valid(ch) || !ch.online) return;
    // boilerplate with one call.
    sleep_online = function(ch, t) {
	sleep(t);
	if (!.tmp.mob.valid(ch)) return false;
	if (!ch.online) return false;
	return true;
    };



    /*
     * schedules extraction to occur in the next tick
     */
    trueExtract = function(obj_or_mob) {
	// Extraction is deferred (C++ callers may still hold the pointer), so mark
	// it doomed now: .tmp.corpse.position destroys it instead of looting it.
	if (obj_or_mob != null && obj_or_mob.online && !obj_or_mob.dead)
	    obj_or_mob.extractPending = true;
	.scheduler.Thread(
		function(objmob) {
			if (objmob.online && !objmob.dead)
			    objmob.extract(true);
			return;
		}, obj_or_mob
	).start(); 
    };
    
    /*
     * returns: null if num is not numerical
     *          numerical representation of num - otherwise
     */
    // block[key] from a config Map (.config(...) or a nested block), or
    // dflt when the block is null or the key is missing.
    cfgNum = function(block, key, dflt) {
	var v;
	if (block == null)
	    return dflt;
	v = block[key + ""];
	if (v == null)
	    return dflt;
	return v;
    };

    toNumber = function(num) {
	try {
	    var n;
	    n=0+num;
	    return n;
	} catch(e) {
	    return null;
	}
    };
    
    // Returns X to the power of Y
    power = function(x, y) {
	var i, result; result = 1;
	for (i = 0; i < y; i = i + 1)
	    result = result * x;
	return result;
    };

    // Pick a message template for the viewer's language. lang: 0=EN, 1=RU, 2=UA
    // (matches ch.displayLang / Player::displayLang). Mirrors the C++ lmsg() so
    // Fenia frame code stops hand-rolling if/else chains; migrates mechanically
    // to Ruffina's ._() when the TranslationManager lands. If a template carries
    // %N$ placeholders, all three MUST reference the same set (the same act args
    // are passed regardless of language) -- lint via scripts/lint-lmsg.py.
    lmsg = function(lang, en, ru, ua) {
	if (lang == 0) return en;
	if (lang == 2) return ua;
	return ru;
    };


    /*
     * transforms list (a1, a2, ... an) into the string "a1, a2, ... , an"
     */
    concatComma = function(msgs) {
	var m, str;

	m = msgs.clone();
	str = "";

	for (;m.size() != 0;) {
	    str = str + m.front();
	    m.pop_front();

	    if (m.size() != 0) str = str + ", ";
	}
	return str;
    };
    
    /*
     * transforms list (a1, as2, ... an) into the string "a1, a2, ... и an"
     */
    concatCommaAnd = function(msgs) {
	var m, str;
	
	m = msgs.clone();
	str = "";

	for (;m.size() != 0;) {
	    str = str + m.front();
	    m.pop_front();

	    if (m.size() == 1)     str = str + " и ";
	    else if (m.size() > 1) str = str + ", ";
	}
	return str;
    };

    /*
     * Like concatCommaAnd, but the final joiner follows the viewer language
     * (en " and ", ru " и ", ua " і "). Use in localized (lmsg) output.
     */
    concatCommaAndL = function(msgs, lang) {
	var m, str;

	m = msgs.clone();
	str = "";

	for (;m.size() != 0;) {
	    str = str + m.front();
	    m.pop_front();

	    if (m.size() == 1)     str = str + .tmp.system.lmsg(lang, " and ", " и ", " і ");
	    else if (m.size() > 1) str = str + ", ";
	}
	return str;
    };

    // Extracts a single russian (1) or english (0) keyword out of a string
    // Used for visualizing interactions with mobs or objects: "order X stand"
    getOneKeyword = function(string, russian) {
	var list; list = string.arguments();
	if (list.size() > 0) {
	    if (russian) {
		for (l in list)
		    if (l.isRussian()) return l;
	    }
	    else return list.front();
	}
	else return "";
    };
    
    // Returns formatted obj name or "something" in the correct case
    // Remember to capitalize the output manually if needed
    objVisMsg = function(ch, obj, case) {
	if (!ch.can_see_obj(obj)) return smthCases[case];
	else return .fmt("%O" + case, obj);
    };
    
    smthCases = .Array();
    smthCases[1] = "нечто";
    smthCases[2] = "чего-то";
    smthCases[3] = "чему-то";
    smthCases[4] = "что-то";
    smthCases[5] = "чем-то";
    smthCases[6] = "чём-то";
    
    // Add this to room affect's onDescr: appends the time left to msg, a line
    // already rendered in ch's language.
    raffectDescr = function(ch, af, msg) {
	if (af.duration >= 0)
	    return msg + " " + .fmtLang(ch.displayLang, ._("{D[{yеще {m%1$d{y час%1$I|а|ов{D]{2.{/"), af.duration);
	return msg + " " + .fmtLang(ch.displayLang, ._("перманентно.{/"));
    };
	
    // Repaints every letter of a room description: main_color, or one of the
    // comma-separated accents with accent_chance percent. Only the colour
    // codes go. Everything else stays as the engine sent it: line breaks
    // ({/ and the text's own), language/sex/time tags, links ({hc exit
    // words, {hh help) and visibility spans ({I...{Ix: the "(keyword)"
    // markers, whose web half carries the read/look click). A link or a
    // marker keeps the colour written right before it, else main_color.
    // Applying it twice gives the same text with new accents.
    recolorDescr = function(descr, main_color, accents, accent_chance) {
	var i, k, c, n, t, len, end, out, pend, main, palette, colours, argTags, invisOpen, linkOpen, spanOpen;
	palette = accents.split(",");
	colours = "b,c,g,m,r,w,y,B,C,G,M,R,W,Y,D,1,2,*,+".split(",");
	argTags = "l,n,s,A,S,T,F".split(",");
	invisOpen = "i,s,w,S,W".split(",");
	linkOpen = "c,l,h,g,s".split(",");
	main = "{" + main_color;
	len = descr.size();
	out = "";
	pend = "";

	for (i = 0; i < len; i = i + 1) {
	    c = descr.at(i);
	    // A lone "{" at the very end would turn the closing {x into "{{x".
	    if (c == "{" && i + 1 >= len)
		break;
	    if (c != "{") {
		if (c.toUpper() != c.toLower()) {
		    if (.chance(accent_chance))
			out = out + "{" + palette.random();
		    else
			out = out + main;
		}
		out = out + c;
		pend = "";
		continue;
	    }

	    i = i + 1;
	    n = descr.at(i);

	    // A colour code: dropped, remembered for a link or marker right after.
	    if (colours.has(n)) {
		if (n != "1" && n != "2" && n != "*" && n != "+")
		    pend = "{" + n;
		continue;
	    }

	    // {l {n {s {A {S {T {F: the tag letter after them is not text.
	    if (argTags.has(n) && i + 1 < len) {
		out = out + "{" + n + descr.at(i + 1);
		i = i + 1;
		continue;
	    }

	    // {I or {h: copied whole up to its closing {Ix / {hx or a total
	    // reset {x. A stray closer is copied as it is.
	    if ((n == "I" || n == "h") && i + 1 < len) {
		t = descr.at(i + 1);
		if (n == "I")
		    spanOpen = invisOpen.has(t);
		else
		    spanOpen = linkOpen.has(t);
		if (!spanOpen) {
		    out = out + "{" + n + t;
		    i = i + 1;
		    continue;
		}

		end = len;
		for (k = i + 2; k + 1 < len; k = k + 1) {
		    if (descr.at(k) != "{")
			continue;
		    t = descr.at(k + 1);
		    if (t == "x" || t == "X") {
			end = k + 2;
			break;
		    }
		    if (t == n && k + 2 < len) {
			t = descr.at(k + 2);
			if (t == "x" || t == "X") {
			    end = k + 3;
			    break;
			}
		    }
		    k = k + 1;
		}

		if (pend == "")
		    out = out + main;
		else
		    out = out + pend;
		out = out + descr.substr(i - 1, end - i + 1);
		i = end - 1;
		pend = "";
		continue;
	    }

	    // Anything else ({/ {{ {x ...) as it is.
	    out = out + "{" + n;
	    if (n == "x" || n == "X")
		pend = "";
	}
	return out + "{x";
    };

})

